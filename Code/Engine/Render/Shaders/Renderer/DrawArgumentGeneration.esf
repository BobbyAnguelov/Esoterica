#include "Engine/Render/Shaders/Renderer/RendererTypes.esh"
#include "Engine/Render/Shaders/Renderer/RendererSurfaceShaderLayout.esh"
#include "Engine/Render/Shaders/EngineShader.esh"
#include "Engine/Render/Shaders/MeshInstance.esh"

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_ROOT_CONSTANTS( DrawArgumentGenerationRootConstants, b0, space0 );
EE_DECLARE_ROOT_CBV( GlobalParameters, b1, space0 );

[RootSignature( DrawArgumentGenerationRootSignature )]
[numthreads( 64, 1, 1 )]
void CS_main( uint groupID : SV_GroupID, uint groupThreadID : SV_GroupThreadID, uint3 dispatchThreadID : SV_DispatchThreadID )
{
    ByteAddressBuffer               drawClusterCountersBuffer       = GetBuffer( RootConstants.m_drawClusterCountersBuffer );
    RWStructuredBuffer<uint>        drawClusterBaseOffsetsBuffer    = GetRWBuffer( RootConstants.m_drawClusterBaseOffsetsBuffer );
    StructuredBuffer<RenderBucket>  renderBucketBuffer              = GetBuffer( RootCBV.m_renderBucketBuffer );

    //-------------------------------------------------------------------------

    if ( groupThreadID == 0 )
    {
        const uint numActiveRenderViews = RootCBV.m_numActiveRenderViews;

        uint runningOffset = 0;
        for ( uint listIndex = 0; listIndex < numActiveRenderViews * EE_NUM_RENDER_BUCKETS_PER_SHADER_PER_VIEW; ++listIndex )
        {
            const uint numDrawClusters = drawClusterCountersBuffer.Load( listIndex * 4 );

            drawClusterBaseOffsetsBuffer[listIndex] = runningOffset;
            runningOffset += numDrawClusters;

            if ( numDrawClusters == 0 )
            {
                continue;
            }

            const uint viewIndex = listIndex / EE_NUM_RENDER_BUCKETS_PER_SHADER_PER_VIEW;
            const uint bucket = listIndex % EE_NUM_RENDER_BUCKETS_PER_SHADER_PER_VIEW;

            const uint bucketBase = viewIndex * RootCBV.m_numRenderViewBucketsPerView + RootConstants.m_shaderIndex * EE_NUM_RENDER_BUCKETS_PER_SHADER_PER_VIEW;

            const RenderBucket renderBucket = renderBucketBuffer[bucketBase + bucket];

            StructuredBuffer<RenderView> renderViewBuffer            = GetBuffer( RootCBV.m_renderViewBuffer );
            StructuredBuffer<uint16_t>   renderViewIndirectionBuffer = GetBuffer( RootCBV.m_renderViewIndirectionBuffer );

            const RenderView renderView = renderViewBuffer[renderViewIndirectionBuffer[viewIndex]];
            const uint numFaces = ( ( renderView.m_renderViewFlags & RENDER_VIEW_FLAG_SHADOW_FACE ) != 0 ) ? g_OctahedralShadowNumFaces : 1;

            RWByteAddressBuffer drawArgumentCounter = GetRWBuffer( NonUniformResourceIndex( renderBucket.m_drawCounterBuffer ) );
            RWStructuredBuffer<DrawArgument> drawArgumentBuffer = GetRWBuffer( NonUniformResourceIndex( renderBucket.m_drawArgumentBuffer ) );

            const uint numArguments = ( numDrawClusters + RHI_MAX_DISPATCH_SIZE - 1 ) / RHI_MAX_DISPATCH_SIZE;
            for ( uint argumentIndex = 0; argumentIndex < numArguments; ++argumentIndex )
            {
                uint drawArgumentIndex = 0;
                drawArgumentCounter.InterlockedAdd( 0, 1, drawArgumentIndex );

                DrawArgument drawArgument = ( DrawArgument )0;
                drawArgument.m_rootConstants.m_drawClusterBufferOffset     = drawClusterBaseOffsetsBuffer[listIndex] + argumentIndex * RHI_MAX_DISPATCH_SIZE;
                drawArgument.m_rootConstants.m_renderViewIndex             = viewIndex;
                drawArgument.m_rootConstants.m_drawClusterBuffer           = RootConstants.m_drawClusterBuffer;
                drawArgument.m_rootConstants.m_clusterToInstanceBuffer     = RootConstants.m_clusterToInstanceBuffer;
                drawArgument.m_rootConstants.m_instanceBuffer              = RootConstants.m_instanceBuffer;
                drawArgument.m_rootCBV                                     = RootCBV.m_deviceAddress;
                drawArgument.m_dispatchArguments                           = uint3( min( numDrawClusters - argumentIndex * RHI_MAX_DISPATCH_SIZE, RHI_MAX_DISPATCH_SIZE ), numFaces, 1 );

                drawArgumentBuffer[drawArgumentIndex] = drawArgument;
            }
        }
    }
}
