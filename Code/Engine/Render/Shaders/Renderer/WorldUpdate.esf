
#include "Engine/Render/Shaders/Renderer/WorldUpdate.esh"
#include "Engine/Render/Shaders/MeshInstance.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct WorldUpdateResourceTable
{
    uint                                                        m_mode;

    RWStructuredBuffer<MeshInstanceRoot>                        m_meshInstanceRootBuffer;
    StructuredBuffer<uint>                                      m_meshInstanceBufferHandles;
    RWStructuredBuffer<LightInstance_DirectionalLight>          m_directionalLightBuffer;
    RWStructuredBuffer<LightInstance_PointLight>                m_pointLightBuffer;
    RWStructuredBuffer<LightInstance_SpotLight>                 m_spotLightBuffer;
    RWStructuredBuffer<SkinningTransform>                       m_skinningTransformBuffer;
    RWStructuredBuffer<RenderView>                              m_renderViewBuffer;
    
    StructuredBuffer<MeshInstanceInitializeCommand>             m_initializeBuffer_MeshInstance;
    StructuredBuffer<PointLightInitializeCommand>               m_initializeBuffer_PointLight;
    StructuredBuffer<SpotLightInitializeCommand>                m_initializeBuffer_SpotLight;
    
    StructuredBuffer<MeshInstanceRootUpdateCommand>             m_updateBuffer_MeshInstanceRoot;
    StructuredBuffer<MeshInstanceTransformUpdateCommand>        m_updateBuffer_MeshInstance;
    StructuredBuffer<SkinningTransformUpdateCommand>            m_updateBuffer_SkinningTransform;
    StructuredBuffer<DirectionalLightUpdateCommand>             m_updateBuffer_DirectionalLight;
    StructuredBuffer<PointLightTransformUpdateCommand>          m_updateBuffer_PointLight;
    StructuredBuffer<SpotLightTransformUpdateCommand>           m_updateBuffer_SpotLight;
    StructuredBuffer<RenderViewUpdateCommand>                   m_updateBuffer_RenderView;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/WorldUpdate.esh"

#ifndef __cplusplus

#define WorldUpdateRootSignature EE_BEGIN_ROOT_SIGNATURE \
                                 WorldUpdateResourceTableRootConstant( "b0", "space=0" ) \
                                 "CBV( b1, space = 0 )"

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_ROOT_CONSTANTS( WorldUpdateResourceTableData, b0, space0 );
EE_DECLARE_ROOT_CBV( WorldUpdateConstants, b1, space0 );

[RootSignature( WorldUpdateRootSignature )]
[numthreads( 64, 1, 1 )]
void CS_main( uint groupID : SV_GroupID, uint groupThreadID : SV_GroupThreadID, uint3 dispatchThreadID : SV_DispatchThreadID )
{
    WorldUpdateResourceTable resourceTable = CreateWorldUpdateResourceTable( RootConstants );
    
    bool isInitMode            = ( resourceTable.m_mode == 0 );
    bool isTransformUpdateMode = ( resourceTable.m_mode == 1 );

    if ( isInitMode && dispatchThreadID.x < RootCBV.m_numInitializeCommands_MeshInstance )
    {
        MeshInstanceInitializeCommand initializeCommand = resourceTable.m_initializeBuffer_MeshInstance[dispatchThreadID.x];

        MeshInstance instance = ( MeshInstance )0;

        instance.m_lodMask                  = initializeCommand.m_lodMask;
        instance.m_meshInstanceRootIndex    = initializeCommand.m_rootIndex;
        instance.m_meshBuffer               = initializeCommand.m_meshBuffer;
        instance.m_instanceHidden           = initializeCommand.m_instanceHidden;
        instance.m_clusterToInstanceOffset  = initializeCommand.m_clusterToInstanceOffset;
        instance.m_shaderParametersOffsetIn32ByteBlocks = initializeCommand.m_shaderParametersOffsetIn32ByteBlocks;

        RWStructuredBuffer<MeshInstance> meshInstanceBuffer = GetRWBuffer( NonUniformResourceIndex( resourceTable.m_meshInstanceBufferHandles[initializeCommand.m_shaderIndex] ) );
        meshInstanceBuffer[initializeCommand.m_instanceID] = instance;
    }

    if ( isInitMode && dispatchThreadID.x < RootCBV.m_numInitializeCommands_PointLight )
    {
        PointLightInitializeCommand initializeCommand = resourceTable.m_initializeBuffer_PointLight[dispatchThreadID.x];

        LightInstance_PointLight light = ( LightInstance_PointLight )0;

        light.m_shadowMapHandle    = initializeCommand.m_shadowMapHandle;
        light.m_shadowResolutionBits = initializeCommand.m_shadowResolutionBits;

        resourceTable.m_pointLightBuffer[initializeCommand.m_instanceID] = light;
    }

    if ( isInitMode && dispatchThreadID.x < RootCBV.m_numInitializeCommands_SpotLight )
    {
        SpotLightInitializeCommand initializeCommand = resourceTable.m_initializeBuffer_SpotLight[dispatchThreadID.x];

        LightInstance_SpotLight light = ( LightInstance_SpotLight )0;

        light.m_shadowMapHandle    = initializeCommand.m_shadowMapHandle;
        light.m_shadowResolutionBits = initializeCommand.m_shadowResolutionBits;

        resourceTable.m_spotLightBuffer[initializeCommand.m_instanceID] = light;
    }

    //-------------------------------------------------------------------------
    
    if ( isTransformUpdateMode && dispatchThreadID.x < RootCBV.m_numUpdateCommands_MeshInstanceRoot )
    {
        MeshInstanceRootUpdateCommand updateCommand = resourceTable.m_updateBuffer_MeshInstanceRoot[dispatchThreadID.x];

        MeshInstanceRoot meshInstanceRoot = resourceTable.m_meshInstanceRootBuffer[updateCommand.m_instanceID];

        meshInstanceRoot.m_rootTransform = updateCommand.m_transform;
        meshInstanceRoot.m_worldAABB = updateCommand.m_packedAABB;

        resourceTable.m_meshInstanceRootBuffer[updateCommand.m_instanceID] = meshInstanceRoot;
    }
    
    if ( isTransformUpdateMode && dispatchThreadID.x < RootCBV.m_numUpdateCommands_MeshInstance )
    {
        MeshInstanceTransformUpdateCommand updateCommand = resourceTable.m_updateBuffer_MeshInstance[dispatchThreadID.x];
        
        RWStructuredBuffer<MeshInstance> meshInstanceBuffer = GetRWBuffer( NonUniformResourceIndex( resourceTable.m_meshInstanceBufferHandles[updateCommand.m_shaderIndex] ) );

        MeshInstance meshInstance = meshInstanceBuffer[updateCommand.m_instanceID];
        meshInstance.m_localTransform = updateCommand.m_transform;
        meshInstanceBuffer[updateCommand.m_instanceID] = meshInstance;
    }
    
    if ( isTransformUpdateMode && dispatchThreadID.x < RootCBV.m_numUpdateCommands_SkinningTransform )
    {
        SkinningTransformUpdateCommand updateCommand = resourceTable.m_updateBuffer_SkinningTransform[dispatchThreadID.x];
        
        uint instanceID = updateCommand.DecodeInstanceID();
        SkinningTransform transform = updateCommand.DecodeSkinningTransform();

        resourceTable.m_skinningTransformBuffer[instanceID] = transform;
    }

    if ( isTransformUpdateMode && dispatchThreadID.x < RootCBV.m_numUpdateCommands_DirectionalLight )
    {
        DirectionalLightUpdateCommand updateCommand = resourceTable.m_updateBuffer_DirectionalLight[dispatchThreadID.x];

        LightInstance_DirectionalLight light = ( LightInstance_DirectionalLight )0;
        
        light.m_maxIntensity            = updateCommand.m_maxIntensity;
        light.m_lightDirection          = updateCommand.m_lightDirection;
        light.m_packedTintedColor       = updateCommand.m_packedTintedColor;
        light.m_shadowCascades          = updateCommand.m_shadowCascades;
        light.m_shadowMatrix            = updateCommand.m_shadowMatrix;
        light.m_cascadeOffsets[0]       = updateCommand.m_cascadeOffsets[0];
        light.m_cascadeOffsets[1]       = updateCommand.m_cascadeOffsets[1];
        light.m_cascadeOffsets[2]       = updateCommand.m_cascadeOffsets[2];
        light.m_cascadeOffsets[3]       = updateCommand.m_cascadeOffsets[3];
        light.m_cascadeScales[0]        = updateCommand.m_cascadeScales[0];
        light.m_cascadeScales[1]        = updateCommand.m_cascadeScales[1];
        light.m_cascadeScales[2]        = updateCommand.m_cascadeScales[2];
        light.m_cascadeScales[3]        = updateCommand.m_cascadeScales[3];
        light.m_cascadeSize             = updateCommand.m_cascadeSize;

        [unroll]
        for ( uint cascadeIndex = 0; cascadeIndex < 4; ++cascadeIndex )
        {
            float const cascadeWorldSize = abs( light.m_cascadeScales[cascadeIndex].x ) * light.m_cascadeSize.x;
            light.m_cascadeTexelWorldSize[cascadeIndex] = ( cascadeWorldSize > 0.0 ) ? ( 1.0 / cascadeWorldSize ) : 0.0;
        }

        resourceTable.m_directionalLightBuffer[updateCommand.m_instanceID] = light;
    }

    if ( isTransformUpdateMode && dispatchThreadID.x < RootCBV.m_numUpdateCommands_RenderView )
    {
        RenderViewUpdateCommand updateCommand = resourceTable.m_updateBuffer_RenderView[dispatchThreadID.x];

        resourceTable.m_renderViewBuffer[updateCommand.m_deviceRenderViewIndex] = updateCommand.m_renderView;
    }

    if ( isTransformUpdateMode && dispatchThreadID.x < RootCBV.m_numUpdateCommands_PointLight )
    {
        PointLightTransformUpdateCommand updateCommand = resourceTable.m_updateBuffer_PointLight[dispatchThreadID.x];
        uint instanceID = updateCommand.m_instanceID;

        LightInstance_PointLight light = resourceTable.m_pointLightBuffer[instanceID];

        light.m_maxIntensity            = updateCommand.m_maxIntensity;
        light.m_lightPosition           = updateCommand.m_lightPosition;
        light.m_maxRadius               = updateCommand.m_maxRadius;
        light.m_falloff                 = updateCommand.m_falloff;
        light.m_packedTintedColor       = updateCommand.m_packedTintedColor;

        resourceTable.m_pointLightBuffer[instanceID] = light;
    }

    if ( isTransformUpdateMode && dispatchThreadID.x < RootCBV.m_numUpdateCommands_SpotLight )
    {
        SpotLightTransformUpdateCommand updateCommand = resourceTable.m_updateBuffer_SpotLight[dispatchThreadID.x];
        uint instanceID = updateCommand.m_instanceID;

        LightInstance_SpotLight light = resourceTable.m_spotLightBuffer[instanceID];

        light.m_maxIntensity            = updateCommand.m_maxIntensity;
        light.m_lightPosition           = updateCommand.m_lightPosition;
        light.m_lightDirection          = updateCommand.m_lightDirection;
        light.m_maxRadius               = updateCommand.m_maxRadius;
        light.m_falloff                 = updateCommand.m_falloff;
        light.m_innerConeAngle          = updateCommand.m_innerConeAngle;
        light.m_outerConeAngle          = updateCommand.m_outerConeAngle;
        light.m_packedTintedColor       = updateCommand.m_packedTintedColor;
        light.m_shadowMatrix            = updateCommand.m_shadowMatrix;

        float const spotBeamCosine  = max( light.m_outerConeAngle, 1.0e-4 );
        light.m_shadowTangent       = sqrt( max( 1.0 - spotBeamCosine * spotBeamCosine, 0.0 ) ) / spotBeamCosine;

        resourceTable.m_spotLightBuffer[instanceID] = light;
    }
}

#endif
