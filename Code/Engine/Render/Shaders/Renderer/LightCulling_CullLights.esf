#include "Engine/Render/Shaders/Renderer/GlobalParameters.esh"
#include "Engine/Render/Shaders/Renderer/LightInstance.esh"
#include "Engine/Render/Shaders/Renderer/CullingRootConstants.esh"
#include "Engine/Render/Shaders/SpatialHash.esh"
#include "Engine/Render/Shaders/DecalInstance.esh"

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_ROOT_CONSTANTS( LightCulling_CullLightsRootConstants, b0, space0 );
EE_DECLARE_ROOT_CBV( GlobalParameters, b1, space0 );

static uint const s_numInstancesPerPage = 32U;
static uint const s_numPagesPerGroup   = 2U;

groupshared uint gsPointMask[ s_numPagesPerGroup ];
groupshared uint gsSpotMask[ s_numPagesPerGroup ];
groupshared uint gsDecalMask[ s_numPagesPerGroup ];

groupshared uint gsCellSlot;

groupshared uint gsPointFirstPage;
groupshared uint gsPointLastPage;

groupshared uint gsSpotFirstPage;
groupshared uint gsSpotLastPage;

groupshared uint gsDecalFirstPage;
groupshared uint gsDecalLastPage;

groupshared uint gsPageStart;
groupshared uint gsPageEnd;

groupshared uint gsParentSlot;
groupshared uint gsParentHasLights;
groupshared uint gsParentPayloadPoint[ s_numPagesPerGroup ];
groupshared uint gsParentPayloadSpot[ s_numPagesPerGroup ];
groupshared uint gsParentPayloadDecal[ s_numPagesPerGroup ];

bool TestPointLightCell( float3 cellCenter, float3 cellHalfExtents, LightInstance_PointLight light )
{
    float3 closest = clamp( light.m_lightPosition, cellCenter - cellHalfExtents, cellCenter + cellHalfExtents );
    float3 delta   = light.m_lightPosition - closest;
    return dot( delta, delta ) < light.m_maxRadius * light.m_maxRadius;
}

// Based on: https://bartwronski.com/2017/04/13/cull-that-cone/
//-------------------------------------------------------------------------

bool TestConeVsSphere( float3 origin, float3 forward, float size, float cosAngle, float sinAngle, float4 testSphere )
{
    const float3 V = testSphere.xyz - origin;
    const float  VlenSq = dot( V, V );
    const float  V1len  = dot( V, forward );
    const float  distanceClosestPoint = cosAngle * sqrt( VlenSq - V1len * V1len ) - V1len * sinAngle;

    const bool angleCull = distanceClosestPoint > testSphere.w;
    const bool frontCull = V1len >  testSphere.w + size;
    const bool backCull  = V1len < -testSphere.w;

    return !( angleCull || frontCull || backCull );
}

//-------------------------------------------------------------------------

[RootSignature( LightCulling_CullLightsRootSignature )]
[numthreads( 64, 1, 1 )]
void CS_main( uint groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID, uint groupIndex : SV_GroupIndex )
{
    if ( groupThreadID == 0 )
    {
        [unroll] for ( uint pageInGroup = 0; pageInGroup < s_numPagesPerGroup; ++pageInGroup )
        {
            gsPointMask[ pageInGroup ] = 0;
            gsSpotMask[ pageInGroup ]  = 0;
            gsDecalMask[ pageInGroup ] = 0;
        }

        gsCellSlot          = ~0U;
        gsParentSlot        = ~0U;
        gsParentHasLights   = 0;
        gsPointFirstPage    = ~0U;
        gsPointLastPage     = 0;
        gsSpotFirstPage     = ~0U;
        gsSpotLastPage      = 0;
        gsDecalFirstPage    = ~0U;
        gsDecalLastPage     = 0;
        gsPageStart         = 0;
        gsPageEnd           = 0;
    }

    GroupMemoryBarrierWithGroupSync();

    SpatialHashRW hash      = CreateSpatialHash( RootCBV.m_lightCulling_SpatialHashLow, RootCBV.m_lightCulling_SpatialHashHigh );
    uint          cellLevel = RootConstants.m_cellLevel;
    bool          isRoot    = ( cellLevel == RootConstants.m_numLODs - 1 );

    // Cell coordinate = groupID + offset (offset is minimum cell coordinate for this LOD's dispatch)
    int3 cellCoord = int3( groupID ) + int3( RootConstants.m_cellOffsetX, RootConstants.m_cellOffsetY, RootConstants.m_cellOffsetZ );

    if ( !isRoot && groupThreadID == 0 )
    {
        int3 parentCoord  = cellCoord >> 1;
        int  parentLevel  = int( cellLevel ) + 1;
        uint parentSlot, numCollisions, checksum;
        if ( hash.TryLookup( parentCoord, parentLevel, parentSlot, numCollisions, checksum ) )
        {
            gsParentSlot = parentSlot;
        }
    }

    GroupMemoryBarrierWithGroupSync();

    // Parent scan: read metadata, compute merged page range, check for work
    if ( !isRoot && gsParentSlot != ~0U && groupThreadID == 0 )
    {
        uint2 pointLightPageRange = hash.LoadMetadata( gsParentSlot, s_pointLightSlot );
        uint2 spotLightPageRange  = hash.LoadMetadata( gsParentSlot, s_spotLightSlot );
        uint2 decalPageRange      = hash.LoadMetadata( gsParentSlot, s_decalSlot );

        gsParentHasLights = ( pointLightPageRange.y != 0 || spotLightPageRange.y != 0 || decalPageRange.y != 0 ) ? 1u : 0;

        uint rangeStart = ~0U;
        uint rangeEnd = 0;
        
        if ( pointLightPageRange.y > 0 )
        {
            rangeStart = min( rangeStart, pointLightPageRange.x );
            rangeEnd = max( rangeEnd, pointLightPageRange.x + pointLightPageRange.y );
        }

        if ( spotLightPageRange.y > 0 )
        {
            rangeStart = min( rangeStart, spotLightPageRange.x );
            rangeEnd = max( rangeEnd, spotLightPageRange.x + spotLightPageRange.y );
        }

        if ( decalPageRange.y > 0 )
        {
            rangeStart = min( rangeStart, decalPageRange.x );
            rangeEnd = max( rangeEnd, decalPageRange.x + decalPageRange.y );
        }

        if ( rangeStart > rangeEnd )
        {
            rangeStart = 0;
            rangeEnd = 0;
        }
        
        gsPageStart = rangeStart;
        gsPageEnd   = rangeEnd;

        // The parent payload masks are only read when this cell has work, which requires a valid parent slot
        [unroll] for ( uint pageInGroup = 0; pageInGroup < s_numPagesPerGroup; ++pageInGroup )
        {
            gsParentPayloadPoint[ pageInGroup ] = 0;
            gsParentPayloadSpot[ pageInGroup ]  = 0;
            gsParentPayloadDecal[ pageInGroup ] = 0;
        }
    }

    GroupMemoryBarrierWithGroupSync();

    bool hasWork = isRoot || ( gsParentSlot != ~0U && gsParentHasLights != 0 );

    float  cellSize        = CellSizeFromLevel( cellLevel, hash.m_baseCellSize );
    float3 cellCenter      = ( float3( cellCoord ) + 0.5F ) * cellSize + RootCBV.m_cameraPosition;
    float  cellRadius      = cellSize * 0.86602540378F;
    float3 cellHalfExtents = cellSize * 0.5F;

    //-------------------------------------------------------------------------

    StructuredBuffer<LightInstance_PointLight>  pointLights     = GetBuffer( RootCBV.m_pointLightBuffer );
    StructuredBuffer<LightInstance_SpotLight>   spotLights      = GetBuffer( RootCBV.m_spotLightBuffer );
    StructuredBuffer<DecalInstance>             decals          = GetBuffer( RootCBV.m_decalBuffer );
    StructuredBuffer<uint>                      pointLightPages = GetBuffer( RootCBV.m_pointLightPageBuffer );
    StructuredBuffer<uint>                      spotLightPages  = GetBuffer( RootCBV.m_spotLightPageBuffer );
    StructuredBuffer<uint>                      decalPages      = GetBuffer( RootCBV.m_decalPageBuffer );

    uint const maxPages = max( max( RootCBV.m_numPointLightPages, RootCBV.m_numSpotLightPages ), RootCBV.m_numDecalPages );

    if ( hasWork )
    {
        uint const startPage = isRoot ? 0 : gsPageStart;
        uint const endPage   = isRoot ? maxPages : gsPageEnd;

        for ( uint pageIndex = startPage; pageIndex < endPage; pageIndex += s_numPagesPerGroup )
        {
            if ( groupThreadID == 0 )
            {
                [unroll] for ( uint pageInGroup = 0; pageInGroup < s_numPagesPerGroup; ++pageInGroup )
                {
                    gsPointMask[ pageInGroup ] = 0;
                    gsSpotMask[ pageInGroup ]  = 0;
                    gsDecalMask[ pageInGroup ] = 0;
                }
            }

            if ( !isRoot && groupThreadID == 0 )
            {
                [unroll] for ( uint pageInGroup = 0; pageInGroup < s_numPagesPerGroup; ++pageInGroup )
                {
                    uint const maskPage = pageIndex + pageInGroup;

                    gsParentPayloadPoint[ pageInGroup ] = ( maskPage < endPage ) ? hash.LoadMask( gsParentSlot, maskPage, s_pointLightSlot ) : 0;
                    gsParentPayloadSpot[ pageInGroup ]  = ( maskPage < endPage ) ? hash.LoadMask( gsParentSlot, maskPage, s_spotLightSlot ) : 0;
                    gsParentPayloadDecal[ pageInGroup ] = ( maskPage < endPage ) ? hash.LoadMask( gsParentSlot, maskPage, s_decalSlot ) : 0;
                }
            }

            GroupMemoryBarrierWithGroupSync();

            uint const pageInGroup  = groupThreadID / s_numInstancesPerPage;
            uint const laneBit      = 1U << ( groupThreadID % s_numInstancesPerPage );
            uint const page         = pageIndex + pageInGroup;
            uint const instance     = page * s_numInstancesPerPage + ( groupThreadID % s_numInstancesPerPage );
            bool const pageInRange  = page < endPage;
            uint64_t const groupBit = 1ULL << groupThreadID;

            // Point lights
            //-------------------------------------------------------------------------

            if ( pageInRange && page < RootCBV.m_numPointLightPages )
            {
                uint const pageMask = pointLightPages[ page ];
                bool const occupied = ( pageMask & laneBit ) != 0;
                bool const inParent = isRoot || ( gsParentPayloadPoint[ pageInGroup ] & laneBit ) != 0;

                bool inCell = false;
                if ( inParent && occupied )
                {
                    inCell = TestPointLightCell( cellCenter, cellHalfExtents, pointLights[ instance ] );
                }

                uint64_t const waveMask = WaveActiveBitOr( inCell ? groupBit : 0ULL );
                if ( WaveIsFirstLane() && waveMask != 0 )
                {
                    InterlockedOr( gsPointMask[ 0 ], uint( waveMask ) );
                    InterlockedOr( gsPointMask[ 1 ], uint( waveMask >> 32 ) );
                }
            }

            // Spot lights
            //-------------------------------------------------------------------------

            if ( pageInRange && page < RootCBV.m_numSpotLightPages )
            {
                uint const pageMask = spotLightPages[ page ];
                bool const occupied = ( pageMask & laneBit ) != 0;
                bool const inParent = isRoot || ( gsParentPayloadSpot[ pageInGroup ] & laneBit ) != 0;

                bool inCell = false;
                if ( inParent && occupied )
                {
                    LightInstance_SpotLight light = spotLights[ instance ];

                    float  sinAngle   = sqrt( saturate( 1.0F - light.m_outerConeAngle * light.m_outerConeAngle ) );
                    float4 testSphere = float4( cellCenter, cellRadius );

                    inCell = TestConeVsSphere( light.m_lightPosition, light.m_lightDirection, light.m_maxRadius, light.m_outerConeAngle, sinAngle, testSphere );
                }

                uint64_t const waveMask = WaveActiveBitOr( inCell ? groupBit : 0ULL );
                if ( WaveIsFirstLane() && waveMask != 0 )
                {
                    InterlockedOr( gsSpotMask[ 0 ], uint( waveMask ) );
                    InterlockedOr( gsSpotMask[ 1 ], uint( waveMask >> 32 ) );
                }
            }

            // Decals
            //-------------------------------------------------------------------------
            
            if ( pageInRange && page < RootCBV.m_numDecalPages )
            {
                uint const pageMask = decalPages[ page ];
                bool const occupied = ( pageMask & laneBit ) != 0;
                bool const inParent = isRoot || ( gsParentPayloadDecal[ pageInGroup ] & laneBit ) != 0;

                bool inCell = false;
                if ( inParent && occupied )
                {
                    inCell = decals[ instance ].TestCell( cellCenter, cellHalfExtents );
                }

                uint64_t const waveMask = WaveActiveBitOr( inCell ? groupBit : 0ULL );
                if ( WaveIsFirstLane() && waveMask != 0 )
                {
                    InterlockedOr( gsDecalMask[ 0 ], uint( waveMask ) );
                    InterlockedOr( gsDecalMask[ 1 ], uint( waveMask >> 32 ) );
                }
            }

            GroupMemoryBarrierWithGroupSync();

            if ( groupThreadID == 0 )
            {
                if ( gsCellSlot == ~0U )
                {
                    bool newCell = false;
                    gsCellSlot = hash.FindOrInsert( cellCoord, cellLevel, newCell );
                }
            }

            GroupMemoryBarrierWithGroupSync();

            // Store this span's masks and track the first and last page each slot occupies
            if ( groupThreadID == 0 && gsCellSlot != ~0U )
            {
                [unroll] for ( uint storedPageInGroup = 0; storedPageInGroup < s_numPagesPerGroup; ++storedPageInGroup )
                {
                    uint const maskPage = pageIndex + storedPageInGroup;
                    if ( maskPage >= endPage )
                    {
                        continue;
                    }

                    uint const pointMask = gsPointMask[ storedPageInGroup ];
                    uint const spotMask  = gsSpotMask[ storedPageInGroup ];
                    uint const decalMask = gsDecalMask[ storedPageInGroup ];

                    hash.StoreMask( gsCellSlot, maskPage, s_pointLightSlot, pointMask );
                    hash.StoreMask( gsCellSlot, maskPage, s_spotLightSlot, spotMask );
                    hash.StoreMask( gsCellSlot, maskPage, s_decalSlot, decalMask );

                    if ( pointMask != 0 )
                    {
                        if ( gsPointFirstPage == ~0U )
                        {
                            gsPointFirstPage = maskPage;
                        }
                        gsPointLastPage = maskPage;
                    }

                    if ( spotMask != 0 )
                    {
                        if ( gsSpotFirstPage == ~0U )
                        {
                            gsSpotFirstPage = maskPage;
                        }
                        gsSpotLastPage = maskPage;
                    }

                    if ( decalMask != 0 )
                    {
                        if ( gsDecalFirstPage == ~0U )
                        {
                            gsDecalFirstPage = maskPage;
                        }
                        gsDecalLastPage = maskPage;
                    }
                }
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();

    // Write metadata to payload
    if ( groupThreadID == 0 && gsCellSlot != ~0U )
    {
        uint numPointLightPages = ( gsPointFirstPage != ~0U ) ? ( gsPointLastPage - gsPointFirstPage + 1 ) : 0;
        uint numSpotLightPages  = ( gsSpotFirstPage  != ~0U ) ? ( gsSpotLastPage  - gsSpotFirstPage  + 1 ) : 0;
        uint numDecalPages      = ( gsDecalFirstPage != ~0U ) ? ( gsDecalLastPage - gsDecalFirstPage + 1 ) : 0;

        hash.StoreMetadata( gsCellSlot, s_pointLightSlot, uint2( gsPointFirstPage, numPointLightPages ) );
        hash.StoreMetadata( gsCellSlot, s_spotLightSlot, uint2( gsSpotFirstPage, numSpotLightPages ) );
        hash.StoreMetadata( gsCellSlot, s_decalSlot, uint2( gsDecalFirstPage, numDecalPages ) );
    }
}
