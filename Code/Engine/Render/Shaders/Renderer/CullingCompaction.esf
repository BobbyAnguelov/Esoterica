#include "Engine/Render/Shaders/Renderer/RendererTypes.esh"
#include "Engine/Render/Shaders/Renderer/RendererSurfaceShaderLayout.esh"
#include "Engine/Render/Shaders/EngineShader.esh"
#include "Engine/Render/Shaders/MeshInstance.esh"

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_ROOT_CONSTANTS( CullingCompactionRootConstants, b0, space0 );

[RootSignature( CullingCompactionRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint groupID : SV_GroupID, uint groupThreadID : SV_GroupThreadID, uint3 dispatchThreadID : SV_DispatchThreadID )
{
    const uint instanceIndex = RootConstants.m_instanceOffset + groupID * 128 + groupThreadID;
    const bool hasInstance   = instanceIndex < RootConstants.m_instanceCapacity;

    //-------------------------------------------------------------------------

    StructuredBuffer<MeshInstance>              meshInstanceBuffer          = GetBuffer( RootConstants.m_instanceBuffer );
    StructuredBuffer<uint64_t>                  instanceVisibilityBuffer    = GetBuffer( RootConstants.m_instanceVisibilityBuffer );
    RWStructuredBuffer<ClusterCullingWorkEntry> cullingWorkBuffer           = GetRWBuffer( RootConstants.m_cullingWorkBuffer );
    RWByteAddressBuffer                         workCounterBuffer           = GetRWBuffer( RootConstants.m_workCounterBuffer );

    //-------------------------------------------------------------------------

    uint numClusters = 0;
    uint clusterToInstanceBase = 0;
    if ( hasInstance )
    {
        const uint64_t instanceMask = instanceVisibilityBuffer[instanceIndex];
        if ( instanceMask != 0 )
        {
            const MeshInstance meshInstance = meshInstanceBuffer[instanceIndex];

            ByteAddressBuffer meshBuffer = GetBuffer( NonUniformResourceIndex( meshInstance.m_meshBuffer ) );
            MeshHeader meshHeader = meshBuffer.Load<MeshHeader>( 0 );

            numClusters = meshHeader.m_numClusters;
            clusterToInstanceBase = meshInstance.m_clusterToInstanceOffset;
        }
    }

    //-------------------------------------------------------------------------

    uint workBufferBase = 0;
    if ( numClusters > 0 )
    {
        workCounterBuffer.InterlockedAdd( 0, numClusters, workBufferBase );
    }

    for ( uint localClusterIndex = 0; localClusterIndex < numClusters; ++localClusterIndex )
    {
        ClusterCullingWorkEntry workEntry = ( ClusterCullingWorkEntry )0;
        workEntry.m_clusterIndex = clusterToInstanceBase + localClusterIndex;

        cullingWorkBuffer[workBufferBase + localClusterIndex] = workEntry;
    }
}
