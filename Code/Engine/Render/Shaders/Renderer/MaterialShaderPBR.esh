
#include "Engine/Render/Shaders/Renderer/GlobalParameters.esh"
#include "Engine/Render/Shaders/Renderer/LightInstance.esh"
#include "Engine/Render/Shaders/Renderer/DrawRootConstants.esh"
#include "Engine/Render/Shaders/Materials/MaterialInput.esh"
#include "Engine/Render/Shaders/Materials/MaterialOutput.esh"
#include "Engine/Render/Shaders/Renderer/ShadowMapSampling.esh"
#include "Engine/Render/Shaders/PBR/PBR.esh"
#include "Engine/Render/Shaders/CommonSamplers.esh"
#include "Engine/Render/Shaders/SpatialHash.esh"
#include "Engine/Render/Shaders/DecalResolve.esh"
#include "Engine/Render/Shaders/MeshInstance.esh"
#include "Engine/Render/Shaders/Materials/Parallax.esh"

MaterialShaderOutput MaterialShaderMain( in MaterialShaderInput materialInput );

#if EE_DEVELOPMENT_TOOLS
#define PS_DEVTOOLS_ARGS , linear float3 barycentrics : SV_Barycentrics
#else
#define PS_DEVTOOLS_ARGS
#endif

[RootSignature( DrawRootSignature )]
#ifdef PERMUTATION_DEPTH_ONLY
void PS_main( bool isFrontFace : SV_IsFrontFace, VertexOutput vertex, PrimitiveOutput primitive PS_DEVTOOLS_ARGS )
#else
float4 PS_main( bool isFrontFace : SV_IsFrontFace, VertexOutput vertex, PrimitiveOutput primitive PS_DEVTOOLS_ARGS ) : SV_Target
#endif
{
    SpatialHashRO                                       spatialHash                 = CreateSpatialHashRO( RootCBV.m_lightCulling_SpatialHashLow, RootCBV.m_lightCulling_SpatialHashHigh );

    StructuredBuffer<LightInstance_DirectionalLight>    directionalLightBuffer      = GetBuffer( RootCBV.m_directionalLightBuffer );
    StructuredBuffer<LightInstance_PointLight>          pointLightBuffer            = GetBuffer( RootCBV.m_pointLightBuffer );
    StructuredBuffer<LightInstance_SpotLight>           spotLightBuffer             = GetBuffer( RootCBV.m_spotLightBuffer );
    StructuredBuffer<DecalInstance>                     decalBuffer                 = GetBuffer( RootCBV.m_decalBuffer );

    StructuredBuffer<uint>                              directionalLightPageBuffer  = GetBuffer( RootCBV.m_directionalLightPageBuffer );

    Texture2D<float>                                    ssaoTexture                 = GetTexture( RootCBV.m_ssaoTexture );

    SamplerState                                        pointClampSampler           = GetPointClampSampler();
    SamplerState                                        linearClampSampler          = GetLinearClampSampler();
    
    //-------------------------------------------------------------------------

    MaterialShaderInput materialInput   = MaterialShaderInput::New( vertex, primitive, RootCBV.m_cameraPosition.xyz );

    ByteAddressBuffer   meshBuffer      = GetBuffer( NonUniformResourceIndex( materialInput.m_primitive.GetMeshBuffer() ) );

    //-------------------------------------------------------------------------

    uint spatialHashSlotIndex       = 0;
    uint spatialHashNumCollisions   = 0;
    uint spatialHashChecksum        = 0;

    bool const hasSpatialHashCell = spatialHash.LoadPayloadCell( materialInput.m_vertex.m_worldPosition, RootCBV.m_cameraPosition.xyz, spatialHashSlotIndex, spatialHashNumCollisions, spatialHashChecksum );
    
    //-------------------------------------------------------------------------

    MaterialShaderOutput materialOutput = MaterialShaderMain( materialInput );

    if ( !isFrontFace )
    {
        materialOutput.m_normal = -materialOutput.m_normal;
    }

    //-------------------------------------------------------------------------

    #ifndef MATERIAL_NO_NORMAL_MAP
        static const bool s_receivesDecalNormal = true;
    #else
        static const bool s_receivesDecalNormal = false;
    #endif

    #if EE_DEVELOPMENT_TOOLS
        float3 debugDirectLight                 = 0.0.xxx;
        float3 debugEnvironmentMapLight         = 0.0.xxx;
        float  debugShadow                      = 1.0;
        float  debugLightComplexity             = 0.0F;
        float  debugSSAO                        = 1.0F;
        uint   numDebugSpatialHashCollisions    = 0;
        uint   debugSpatialHashCellChecksum     = 0;
        uint   numDebugPayloadPages             = 0;
    #endif

    // Decals only affect shading, so they are compiled out of the depth-only permutations
    #ifndef PERMUTATION_DEPTH_ONLY

    DecalCoverage decalCoverage = DecalCoverage::Neutral();

    // Mesh decals
    //-------------------------------------------------------------------------

    uint const meshDecal = materialInput.m_primitive.GetMeshDecal();
    if ( meshDecal != 0 && ( materialInput.m_primitive.m_primitiveFlags.m_rendererGlobalFlags & g_rendererGlobalFlagDisableDecals ) == 0 )
    {
        uint const meshDecalDataOffset = materialInput.m_primitive.GetMeshDecalDataOffset();
        if ( meshDecalDataOffset != 0 )
        {
            uint const firstMeshDecalProjection = meshDecal & g_meshDecalOffsetMask;
            uint const numMeshDecalProjections = meshDecal >> g_meshDecalCountShift;

            MeshDecalData const meshDecalData = meshBuffer.Load<MeshDecalData>( meshDecalDataOffset );
            float2 const meshDecalUV = materialInput.m_vertex.m_uv.xy;

            [loop] for ( uint decalIdx = 0; decalIdx < numMeshDecalProjections; decalIdx++ )
            {
                MeshDecalProjection const       projection      = meshBuffer.Load<MeshDecalProjection>( meshDecalData.m_projectionOffset + ( firstMeshDecalProjection + decalIdx ) * sizeof( MeshDecalProjection ) );
                MeshDecalProjectionBasis const  projectionBasis = meshBuffer.Load<MeshDecalProjectionBasis>( meshDecalData.m_projectionBasisOffset + projection.m_basisIndex * sizeof( MeshDecalProjectionBasis ) );
                MeshDecal const                 decal           = meshBuffer.Load<MeshDecal>( meshDecalData.m_decalTableOffset + projection.m_decalIndex * sizeof( MeshDecal ) );

                float2 const anchorDelta    = meshDecalUV - projectionBasis.m_anchorUV;
                float4 const linearPart     = float4( projectionBasis.m_linear );

                float2 const decalSpace = float2
                (
                    dot( linearPart.xy, anchorDelta ) + projection.m_offset[0],
                    dot( linearPart.zw, anchorDelta ) + projection.m_offset[1]
                );

                float2 const ddxDecalSpace = float2( dot( linearPart.xy, materialInput.m_ddxUV ), dot( linearPart.zw, materialInput.m_ddxUV ) );
                float2 const ddyDecalSpace = float2( dot( linearPart.xy, materialInput.m_ddyUV ), dot( linearPart.zw, materialInput.m_ddyUV ) );

                ResolveMeshDecal( materialOutput, decalCoverage, decal, decalSpace, ddxDecalSpace, ddyDecalSpace, materialInput, isFrontFace, s_receivesDecalNormal );
            }
        }
    }

    // World decals
    //-------------------------------------------------------------------------

    if ( ( materialInput.m_primitive.m_primitiveFlags.m_rendererGlobalFlags & g_rendererGlobalFlagDisableDecals ) == 0 && RootCBV.m_numDecalPages != 0 && hasSpatialHashCell )
    {
        uint2 const decalPageRange = spatialHash.LoadMetadata( spatialHashSlotIndex, s_decalSlot );

        if ( decalPageRange.y != 0 )
        {
            uint const decalMaskStart = decalPageRange.x;
            uint const decalMaskEnd   = decalPageRange.x + decalPageRange.y;
            uint const numDecalPages  = RootCBV.m_numDecalPages;

            #if EE_DEVELOPMENT_TOOLS
                numDebugPayloadPages += min( decalPageRange.y, RootCBV.m_numDecalPages );
            #endif

            uint const pageRangeStart = WaveActiveMin( decalMaskStart );
            uint const pageRangeEnd   = WaveActiveMax( decalMaskEnd );

            [loop] for ( uint pageIndex = pageRangeStart; pageIndex < pageRangeEnd; ++pageIndex )
            {
                bool const hasDecalPage = ( pageIndex < numDecalPages ) && ( pageIndex >= decalMaskStart ) && ( pageIndex < decalMaskEnd );

                uint decalMask = hasDecalPage ? spatialHash.LoadMask( spatialHashSlotIndex, pageIndex, s_decalSlot ) : 0;
                decalMask = WaveReadLaneFirst( WaveActiveBitOr( decalMask ) );

                #if EE_DEVELOPMENT_TOOLS
                    debugLightComplexity += float( countbits( decalMask ) );
                #endif

                [loop] while ( decalMask != 0 )
                {
                    uint const bit = firstbitlow( decalMask );
                    decalMask ^= ( 1U << bit );

                    ResolveDecal
                    (
                        materialOutput,
                        decalCoverage,
                        decalBuffer[pageIndex * 32 + bit],
                        materialInput,
                        isFrontFace,
                        s_receivesDecalNormal
                    );
                }
            }
        }
    }

    #endif // PERMUTATION_DEPTH_ONLY

    //-------------------------------------------------------------------------

    float3 const triangleNormal = isFrontFace ? primitive.GetTriangleNormal() : -primitive.GetTriangleNormal();

    float3 const shadingPositionOffset = materialOutput.m_normal * ( materialOutput.m_height * materialOutput.m_maxDisplacement );
    float3 const shadingWorldPosition  = materialInput.m_vertex.m_worldPosition + shadingPositionOffset;
    float3 const shadingView           = normalize( RootCBV.m_cameraPosition.xyz - shadingWorldPosition );

    PBR pbr = PBR::New
    (
        materialOutput.m_albedo,
        materialOutput.m_metalness,
        materialOutput.m_roughness,
        materialOutput.m_occlusion,
        materialOutput.m_normal,
        shadingView
    );
      
    float  shadow = 1.0;
    float3 debugShadowColor = 0.0.xxx;

    float4 result = float4( 0.0.xxx, materialOutput.m_opacity );

    [branch] if ( ( primitive.m_primitiveFlags.m_rendererGlobalFlags & g_rendererGlobalFlagDisableLighting ) == 0 )
    {
        Texture2D                       dfgTexture          = GetTexture( RootCBV.m_dfgTexture );
        TextureCube                     radianceTexture     = GetTexture( RootCBV.m_radianceTexture );
        StructuredBuffer<SH::L2_RGB>    shCoefficients      = GetBuffer( RootCBV.m_shCoefficientsBuffer );
        
        float3      IBL                 = pbr.ComputeIBL( shCoefficients, dfgTexture, radianceTexture, RootCBV.m_radianceTextureMipLevels );
        float2      screenUV            = vertex.m_clipPosition.xy * RootCBV.m_viewportSize.zw;
        
        static const RendererGlobalFlags SSAO_EXCLUDE_FLAGS = g_rendererGlobalFlagDisableLighting | g_rendererGlobalFlagDisableSSAO;
        [branch] if ( ( primitive.m_primitiveFlags.m_rendererGlobalFlags & SSAO_EXCLUDE_FLAGS ) == 0 )
        {
            float ssao = ssaoTexture.SampleLevel( linearClampSampler, screenUV, 0 ).r;
            IBL *= ssao;

            #if EE_DEVELOPMENT_TOOLS
            debugSSAO = ssao;
            #endif
        }

        #if EE_DEVELOPMENT_TOOLS
            debugEnvironmentMapLight = IBL;
        #endif
        
        result.rgb = IBL;

        // Directional lights - page buffer is uniform across all lanes, no wave ops needed
        //-------------------------------------------------------------------------

        [loop] for ( uint pageIndex = 0; pageIndex < RootCBV.m_numDirectionalLightPages; ++pageIndex )
        {
            uint directionalLightMask = directionalLightPageBuffer[pageIndex];

            [loop] while ( directionalLightMask != 0 )
            {
                uint const bit = firstbitlow( directionalLightMask );
                directionalLightMask ^= ( 1U << bit );

                LightInstance_DirectionalLight directionalLight = directionalLightBuffer[ ( pageIndex * 32 ) + bit ];

                float3 lightDirection       = directionalLight.m_lightDirection;
                float  shadowDirectional    = 1.0;

                float3 lightColor = UnpackColor( directionalLight.m_packedTintedColor ).rgb * directionalLight.m_maxIntensity;

                if ( directionalLight.m_shadowCascades != 0xFFFF )
                {
                    // Rasterized position, per the shadow ray origin rule above.
                    shadowDirectional = SampleDirectionalLightShadow( directionalLight, materialInput.m_vertex.m_worldPosition, triangleNormal, debugShadowColor );

                    #if EE_DEVELOPMENT_TOOLS
                        debugShadow = min( debugShadow, shadowDirectional );
                    #endif
                }

                float3 directLight = pbr.ComputeDirectLight( lightColor, lightDirection ) * shadowDirectional;

                #if EE_DEVELOPMENT_TOOLS
                    debugDirectLight += directLight;
                #endif

                result.rgb += directLight;
            }
        }

        // Point + Spot lights via spatial hash.
        //-------------------------------------------------------------------------

        if ( hasSpatialHashCell )
        {
            #if EE_DEVELOPMENT_TOOLS
                numDebugSpatialHashCollisions = spatialHashNumCollisions;
                debugSpatialHashCellChecksum = spatialHashChecksum;
            #endif

            uint2 pointLightPageRange = spatialHash.LoadMetadata( spatialHashSlotIndex, 0 );
            uint2 spotLightPageRange  = spatialHash.LoadMetadata( spatialHashSlotIndex, 1 );

            #if EE_DEVELOPMENT_TOOLS
                numDebugPayloadPages += pointLightPageRange.y + spotLightPageRange.y;
            #endif

            // Compute unified page range across both light types for linear memory access
            //-------------------------------------------------------------------------

            uint pageRangeStart = WaveActiveMin( min( ( pointLightPageRange.y > 0 ) ? pointLightPageRange.x : ~0U, ( spotLightPageRange.y  > 0 ) ? spotLightPageRange.x  : ~0U ) );
            uint pageRangeEnd   = WaveActiveMax( max( ( pointLightPageRange.y > 0 ) ? ( pointLightPageRange.x + pointLightPageRange.y ) : 0, ( spotLightPageRange.y  > 0 ) ? ( spotLightPageRange.x  + spotLightPageRange.y  ) : 0 ) );

            pageRangeEnd = min( pageRangeEnd, max( RootCBV.m_numPointLightPages, RootCBV.m_numSpotLightPages ) );

            [loop] for ( uint pageIndex = pageRangeStart; pageIndex < pageRangeEnd; ++pageIndex )
            {
                bool hasPointLightPage = ( pageIndex >= pointLightPageRange.x ) && ( pageIndex < pointLightPageRange.x + pointLightPageRange.y );
                bool hasSpotLightPage  = ( pageIndex >= spotLightPageRange.x  ) && ( pageIndex < spotLightPageRange.x  + spotLightPageRange.y  );

                // Point lights
                //-------------------------------------------------------------------------
                
                uint pointLightMask = hasPointLightPage ? spatialHash.LoadMask( spatialHashSlotIndex, pageIndex, s_pointLightSlot ) : 0;
                pointLightMask = WaveReadLaneFirst( WaveActiveBitOr( pointLightMask ) );

                #if EE_DEVELOPMENT_TOOLS
                    debugLightComplexity += float( countbits( pointLightMask ) );
                #endif

                [loop] while ( pointLightMask != 0 )
                {
                    uint const bit = firstbitlow( pointLightMask );
                    pointLightMask ^= ( 1U << bit );

                    LightInstance_PointLight pointLight = pointLightBuffer[ ( pageIndex * 32 ) + bit ];

                    float3 lightVector      = pointLight.m_lightPosition - shadingWorldPosition;
                    float3 lightDirection   = normalize( lightVector );
                    float  attenuation      = AttenuationNoCusp( length( lightVector ), pointLight.m_maxRadius, pointLight.m_maxIntensity, pointLight.m_falloff );
                    float3 lightRadiance    = UnpackColor( pointLight.m_packedTintedColor ).rgb * attenuation;

                    float  shadowPoint      = 1.0;
                    if ( pointLight.m_shadowMapHandle != 0xFFFF )
                    {
                        shadowPoint = SamplePointLightShadow( pointLight, materialInput.m_vertex.m_worldPosition, triangleNormal );

                        #if EE_DEVELOPMENT_TOOLS
                            debugShadow = min( debugShadow, shadowPoint );
                        #endif
                    }

                    float3 directLight      = pbr.ComputeDirectLight( lightRadiance, lightDirection ) * shadowPoint;

                    #if EE_DEVELOPMENT_TOOLS
                        debugDirectLight += directLight;
                    #endif

                    result.rgb += directLight;
                }

                // Spot lights
                //-------------------------------------------------------------------------
                
                uint spotLightMask = hasSpotLightPage ? spatialHash.LoadMask( spatialHashSlotIndex, pageIndex, s_spotLightSlot ) : 0;
                spotLightMask = WaveReadLaneFirst( WaveActiveBitOr( spotLightMask ) );

                #if EE_DEVELOPMENT_TOOLS
                    debugLightComplexity += float( countbits( spotLightMask ) * 2 );
                #endif

                [loop] while ( spotLightMask != 0 )
                {
                    uint const bit = firstbitlow( spotLightMask );
                    spotLightMask ^= ( 1U << bit );

                    LightInstance_SpotLight spotLight = spotLightBuffer[ ( pageIndex * 32 ) + bit ];

                    float3  lightVector     = spotLight.m_lightPosition - shadingWorldPosition;
                    float3  lightDirection  = normalize( lightVector );
                    float   cosTheta        = dot( lightDirection, -spotLight.m_lightDirection );
                    float   coneAttenuation = smoothstep( spotLight.m_outerConeAngle, spotLight.m_innerConeAngle, cosTheta );
                    float   attenuation     = AttenuationNoCusp( length( lightVector ), spotLight.m_maxRadius, spotLight.m_maxIntensity, spotLight.m_falloff );
                    float3  lightRadiance   = UnpackColor( spotLight.m_packedTintedColor ).rgb * attenuation * coneAttenuation;

                    float   shadowSpot      = 1.0;
                    if ( spotLight.m_shadowMapHandle != 0xFFFF )
                    {
                        shadowSpot = SampleSpotLightShadow( spotLight, materialInput.m_vertex.m_worldPosition, triangleNormal );

                        #if EE_DEVELOPMENT_TOOLS
                            debugShadow = min( debugShadow, shadowSpot );
                        #endif
                    }

                    float3  directLight     = pbr.ComputeDirectLight( lightRadiance, lightDirection ) * shadowSpot;

                    #if EE_DEVELOPMENT_TOOLS
                        debugDirectLight += directLight;
                    #endif

                    result.rgb += directLight;
                }
            }
        }
    }

    result.rgb += materialOutput.m_emissiveColor;

    // Debug stuff
    //-------------------------------------------------------------------------

    #if EE_DEVELOPMENT_TOOLS
        RendererDebugVisualizationMode debugVisMode = primitive.m_primitiveFlags.m_rendererDebugVisualizationMode;

        RendererDebugFlags debugFlags = materialOutput.m_primitiveFlags.m_rendererDebugFlags;
        debugFlags |= primitive.m_primitiveFlags.m_rendererDebugFlags;
    
        if ( debugVisMode == g_rendererDebugVisualizationModeDirectLight )
        {
            result.rgb = debugDirectLight;
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeEnvironmentMapLight )
        {
            result.rgb = debugEnvironmentMapLight;
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeShadows )
        {
            result.rgb = debugShadow.xxx;
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeAlbedo )
        {
            result.rgb = materialOutput.m_albedo.rgb;
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeNormals )
        {
            result.rgb = materialOutput.m_normal * 0.5 + 0.5.xxx;
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeMetalness )
        {
            result.rgb = materialOutput.m_metalness.xxx;
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeRoughness )
        {
            result.rgb = materialOutput.m_roughness.xxx;
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeAmbientOcclusion )
        {
            result.rgb = materialOutput.m_occlusion.xxx;
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeLightComplexity )
        {
            result.rgb = lerp( float3(0.0, 1.0, 0.0 ), float3( 1.0, 0.0, 0.0 ), saturate( debugLightComplexity / 32.0 ) );
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeSSAO )
        {
            result.rgb = debugSSAO.xxx;
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeLightHashCells )
        {
            if ( numDebugSpatialHashCollisions == 0 )
            {
                result.rgb = 0.0.xxx; // no cell found
            }
            else
            {
                // Generate visually distinct per-cell color
                uint h = debugSpatialHashCellChecksum;
                h = ( h ^ ( h >> 13 ) ) * 0x5BD1E995;
                h = ( h ^ ( h >> 16 ) );
                result.rgb = float3( ( h >>  0 ) & 0xFF, ( h >> 8 ) & 0xFF, ( h >> 16 ) & 0xFF ) / 255.0;
            }
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeLightHashCollisions )
        {
            if ( numDebugSpatialHashCollisions == 0 )
            {
                result.rgb = float3( 0.2, 0.2, 0.2 );
            }
            else if ( numDebugSpatialHashCollisions <= 5 )
            {
                result.rgb = lerp( float3( 0.0, 1.0, 0.0 ), float3( 1.0, 0.0, 0.0 ), saturate( ( numDebugSpatialHashCollisions - 1 ) / 4.0 ) );
            }
            else if ( numDebugSpatialHashCollisions <= 10 )
            {
                result.rgb = lerp( float3( 1.0, 0.0, 0.0 ), float3( 0.5, 0.0, 0.5 ), saturate( ( numDebugSpatialHashCollisions - 5 ) / 5.0 ) );
            }
            else
            {
                result.rgb = float3( 0.5, 0.0, 0.5 );
            }
        }

        if ( debugVisMode == g_rendererDebugVisualizationModeLightHashPayloadComplexity )
        {
            float t = saturate( float( numDebugPayloadPages ) / 8.0 );
            if ( numDebugPayloadPages <= 8 )
            {
                result.rgb = lerp( float3( 0.0, 1.0, 0.0 ), float3( 1.0, 0.0, 0.0 ), t );
            }
            else
            {
                result.rgb = lerp( float3( 1.0, 0.0, 0.0 ), float3( 0.5, 0.0, 0.5 ), saturate( ( float( numDebugPayloadPages ) - 8.0 ) / 8.0 ) );
            }
        }
    
        if ( debugFlags & g_rendererDebugFlagShowWireframe )
        {
            float3 edgeDistance = barycentrics;
            edgeDistance.z = 1.0 - edgeDistance.x - edgeDistance.y;
        
            float3 edgeWidth = fwidth( edgeDistance ) * 0.5;
            edgeWidth = smoothstep( edgeWidth, 2.0 * edgeWidth, edgeDistance );
        
            float minWidth = min( edgeWidth.x, min( edgeWidth.y, edgeWidth.z ) );
        
            result.rgb = lerp( float3( 1.0, 0.4, 0.0 ), result.rgb, minWidth );
        }

        if ( debugFlags & g_rendererDebugFlagShowShadowCascades )
        {
            result.rgb = debugShadowColor * shadow;
        }

        if ( debugFlags & g_rendererDebugFlagShowParallaxCost )
        {
            result.rgb = ParallaxCostDebugColor( materialOutput.m_numParallaxSteps, RootCBV.m_parallaxMaxSteps );
        }
    #endif

    //-------------------------------------------------------------------------

    #ifdef PERMUTATION_ALPHA_TEST
    clip( result.a - 0.1 ); // TODO: Make it a parameter
    #endif

    #ifndef PERMUTATION_DEPTH_ONLY
    return result;
    #endif
}

#if EE_DEVELOPMENT_TOOLS
[RootSignature( DrawRootSignature )]
uint PS_main_OutlineID( bool isFrontFace : SV_IsFrontFace, VertexOutput vertex, PrimitiveOutput primitive ) : SV_Target
{
    StructuredBuffer<MeshInstance> meshInstanceBuffer = GetBuffer( RootConstants.m_instanceBuffer );
    return meshInstanceBuffer[primitive.GetInstanceIndex()].m_meshInstanceRootIndex;
}
#endif
