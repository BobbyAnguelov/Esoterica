
#include "Engine/Render/Shaders/Renderer/RendererTypes.esh"
#include "Engine/Render/Shaders/Renderer/RendererSurfaceShaderLayout.esh"
#include "Engine/Render/Shaders/EngineShader.esh"
#include "Engine/Render/Shaders/Debug/DebugDraw.esh"
#include "Engine/Render/Shaders/MeshInstance.esh"

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_ROOT_CONSTANTS( InstanceCullingRootConstants, b0, space0 );
EE_DECLARE_ROOT_CBV( GlobalParameters, b1, space0 );

[RootSignature( InstanceCullingRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint groupThreadID : SV_GroupThreadID, uint groupID : SV_GroupID, uint3 dispatchThreadID : SV_DispatchThreadID )
{
    const uint instanceIndex = RootConstants.m_instanceOffset + groupID * 128 + groupThreadID;
    if ( instanceIndex >= RootConstants.m_instanceCapacity )
    {
        return;
    }

    StructuredBuffer<MeshInstance>              meshInstanceBuffer          = GetBuffer( RootConstants.m_instanceBuffer );
    StructuredBuffer<uint64_t>                  meshInstancePageBuffer      = GetBuffer( RootConstants.m_instancePageBuffer );
    StructuredBuffer<MeshInstanceRoot>          meshInstanceRootBuffer      = GetBuffer( RootCBV.m_meshInstanceRootBuffer );
    StructuredBuffer<RenderView>                renderViewBuffer            = GetBuffer( RootCBV.m_renderViewBuffer );
    StructuredBuffer<uint16_t>                  renderViewIndirectionBuffer = GetBuffer( RootCBV.m_renderViewIndirectionBuffer );
    RWStructuredBuffer<uint64_t>                instanceVisibilityBuffer    = GetRWBuffer( RootConstants.m_instanceVisibilityBuffer );

    #if EE_DEVELOPMENT_TOOLS
    StructuredBuffer<uint64_t>                  meshInstanceRootOutlineBuffer = GetBuffer( RootCBV.m_meshInstanceRootOutlineBuffer );
    #endif

    //-------------------------------------------------------------------------

    uint64_t const meshInstancePage     = meshInstancePageBuffer[instanceIndex >> 6];
    uint64_t const meshInstancePageMask = ( 1ULL << ( instanceIndex & 63U ) );

    uint64_t viewMask = 0;

    if ( meshInstancePage & meshInstancePageMask )
    {
        const MeshInstance      meshInstance     = meshInstanceBuffer[instanceIndex];
        const MeshInstanceRoot  meshInstanceRoot = meshInstance.LoadRoot( meshInstanceRootBuffer );

        if ( !meshInstanceRoot.m_instanceHidden )
        {
            float3x4 meshInstanceTransform = meshInstance.ComputeWorldTransform( meshInstanceRoot );

            float3 rootAABBCenterWorld;
            float3 rootAABBHalfExtentsWorld;
            meshInstanceRoot.GetWorldAABB( rootAABBCenterWorld, rootAABBHalfExtentsWorld );

            // Compute LOD - the distance is measured to the closest point on the root AABB; camera inside the AABB maps to distance 0
            uint selectedLOD = 0;
            {
                float3 cameraToAABB = RootCBV.m_cameraPosition.xyz - rootAABBCenterWorld;
                float3 closestPointDelta = clamp( cameraToAABB, -rootAABBHalfExtentsWorld, rootAABBHalfExtentsWorld );
                float distanceToCameraSquared = dot( cameraToAABB - closestPointDelta, cameraToAABB - closestPointDelta );

                [unroll( 8 )]
                for ( uint lodIndex = 0; lodIndex < meshInstanceRoot.m_numLODs; ++lodIndex )
                {
                    selectedLOD = lodIndex;

                    float lodDistance = meshInstanceRoot.GetLODDistance( lodIndex );
                    if ( distanceToCameraSquared <= ( lodDistance * lodDistance ) )
                    {
                        break;
                    }
                }
            }

            selectedLOD = max( selectedLOD, meshInstanceRoot.m_forceMinLOD );
            if ( meshInstanceRoot.m_useForcedLOD )
            {
                selectedLOD = meshInstanceRoot.m_forceLOD;
            }

            if ( !meshInstance.m_instanceHidden && meshInstance.IsVisibleInLOD( selectedLOD ) )
            {
                ByteAddressBuffer meshBuffer = GetBuffer( NonUniformResourceIndex( meshInstance.m_meshBuffer ) );
                MeshHeader meshHeader = meshBuffer.Load<MeshHeader>( 0 );

                // Culling AABB - skinned instances use the root AABB, static instances transform the mesh-local bounds
                float3 aabbCenterWorld = rootAABBCenterWorld;
                float3 aabbHalfExtentsWorld = rootAABBHalfExtentsWorld;
                if ( meshInstanceRoot.m_boneOffset == ~0U )
                {
                    TransformAABB( meshInstanceTransform, meshHeader.m_aabbCenterLocal, meshHeader.m_aabbHalfExtentsLocal, aabbCenterWorld, aabbHalfExtentsWorld );
                }

                float3 aabbMinWorld = aabbCenterWorld - aabbHalfExtentsWorld;
                float3 aabbMaxWorld = aabbCenterWorld + aabbHalfExtentsWorld;

                // Cull the instance in all active views
                for ( uint renderViewIndex = 0; renderViewIndex < RootCBV.m_numActiveRenderViews; ++renderViewIndex )
                {
                    RenderView renderView = renderViewBuffer[renderViewIndirectionBuffer[renderViewIndex]];

                    float4 viewPlanes[6];
                    renderView.ComputeViewPlanes( viewPlanes );

                    if ( ( renderView.m_renderViewLayerFlags & meshInstanceRoot.m_renderViewLayerFlags ) == 0 )
                    {
                        continue;
                    }

                    // Special case - global environment map view shouldn't compute lighting
                    float3 worldPositionOffset = 0.0.xxx;
                    if ( ( meshInstanceRoot.m_renderViewLayerFlags & RENDER_VIEW_LAYER_FLAG_GLOBAL_ENVIRONMENT_MAP ) )
                    {
                        // Envmap geometry is rendered in other views as well, but in that case it is always relative to camera
                        if ( ( renderView.m_renderViewLayerFlags & RENDER_VIEW_LAYER_FLAG_GLOBAL_ENVIRONMENT_MAP ) == 0 )
                        {
                            worldPositionOffset = RootCBV.m_cameraPosition.xyz;
                        }
                    }

                    bool visibleInThisView;
                    if ( ( renderView.m_renderViewFlags & RENDER_VIEW_FLAG_SHADOW_FACE ) != 0 )
                    {
                        visibleInThisView = IsSphereVisible( aabbCenterWorld + worldPositionOffset, aabbHalfExtentsWorld, renderView.m_shadowLightSphere.xyz, renderView.m_shadowLightSphere.w );
                    }
                    else
                    {
                        visibleInThisView = IsFrustumVisible( aabbCenterWorld + worldPositionOffset, aabbHalfExtentsWorld, viewPlanes );
                    }

                    if ( visibleInThisView )
                    {
                    #if 0 // TODO: This causes a lot of issues with punctual shadows
                        float4 projectedAABB = 0.0.xxxx;
                        if ( renderView.ProjectBox( aabbMinWorld + worldPositionOffset, aabbMaxWorld + worldPositionOffset, projectedAABB ) )
                        {
                            float width = ( projectedAABB.z - projectedAABB.x ) * renderView.m_renderTargetSize.x;
                            float height = ( projectedAABB.w - projectedAABB.y ) * renderView.m_renderTargetSize.y;

                            // Size is less than 2 pixels -> cull
                            if ( width < 2.0 && height < 2.0 )
                            {
                                visibleInThisView = false;
                            }
                        }
                    #endif
                    }

                    if ( visibleInThisView )
                    {
                        viewMask |= 1ULL << renderViewIndex;
                    }
                }

                #if EE_DEVELOPMENT_TOOLS
                if ( RootCBV.m_editorOutlineEnabled )
                {
                    uint const      meshInstanceRootIndex       = meshInstance.m_meshInstanceRootIndex;
                    uint64_t const  meshInstanceRootOutlinePage = meshInstanceRootOutlineBuffer[meshInstanceRootIndex >> 6];
                    uint64_t const  meshInstanceRootOutlineMask = 1ULL << ( meshInstanceRootIndex & 63U );

                    if ( ( meshInstanceRootOutlinePage & meshInstanceRootOutlineMask ) == 0 )
                    {
                        uint const outlineViewIndex = RootCBV.m_editorOutlineRenderViewIndex;
                        if ( outlineViewIndex < RootCBV.m_numActiveRenderViews )
                        {
                            viewMask &= ~( 1ULL << outlineViewIndex );
                        }
                    }
                }
                #endif
            }
        }
    }

    instanceVisibilityBuffer[instanceIndex] = viewMask;
}
