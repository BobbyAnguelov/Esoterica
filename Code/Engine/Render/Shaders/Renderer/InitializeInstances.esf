
#include "Engine/Render/Shaders/Renderer/WorldUpdate.esh"
#include "Engine/Render/Shaders/Renderer/LightInstance.esh"
#include "Engine/Render/Shaders/MeshInstance.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct InitializeInstancesResourceTable
{
    StructuredBuffer<uint>                                      m_meshInstanceBufferHandles;

    RWStructuredBuffer<LightInstance_PointLight>                m_pointLightBuffer;
    RWStructuredBuffer<LightInstance_SpotLight>                 m_spotLightBuffer;
    RWStructuredBuffer<DecalInstance>                           m_decalBuffer;

    StructuredBuffer<MeshInstanceInitializeCommand>             m_initializeBuffer_MeshInstance;
    StructuredBuffer<PointLightInitializeCommand>               m_initializeBuffer_PointLight;
    StructuredBuffer<SpotLightInitializeCommand>                m_initializeBuffer_SpotLight;
    StructuredBuffer<DecalInstanceInitializeCommand>            m_initializeBuffer_Decal;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/InitializeInstances.esh"

#ifndef __cplusplus

#define InitializeInstancesRootSignature EE_BEGIN_ROOT_SIGNATURE \
                                         InitializeInstancesResourceTableRootConstant( "b0", "space=0" ) \
                                         "CBV( b1, space = 0 )"

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_ROOT_CONSTANTS( InitializeInstancesResourceTableData, b0, space0 );
EE_DECLARE_ROOT_CBV( WorldUpdateConstants, b1, space0 );

[RootSignature( InitializeInstancesRootSignature )]
[numthreads( 64, 1, 1 )]
void CS_main( uint groupID : SV_GroupID, uint groupThreadID : SV_GroupThreadID, uint3 dispatchThreadID : SV_DispatchThreadID )
{
    InitializeInstancesResourceTable resourceTable = CreateInitializeInstancesResourceTable( RootConstants );

    if ( dispatchThreadID.x < RootCBV.m_numInitializeCommands_MeshInstance )
    {
        MeshInstanceInitializeCommand initializeCommand = resourceTable.m_initializeBuffer_MeshInstance[dispatchThreadID.x];

        MeshInstance instance = ( MeshInstance )0;

        instance.m_lodMask                  = initializeCommand.m_lodMask;
        instance.m_meshInstanceRootIndex    = initializeCommand.m_rootIndex;
        instance.m_meshBuffer               = initializeCommand.m_meshBuffer;
        instance.m_instanceHidden           = initializeCommand.m_instanceHidden;
        instance.m_clusterToInstanceOffset  = initializeCommand.m_clusterToInstanceOffset;
        instance.m_shaderParametersOffsetIn32ByteBlocks = initializeCommand.m_shaderParametersOffsetIn32ByteBlocks;

        RWStructuredBuffer<MeshInstance> meshInstanceBuffer = GetRWBuffer( NonUniformResourceIndex( resourceTable.m_meshInstanceBufferHandles[initializeCommand.m_shaderIndex] ) );
        meshInstanceBuffer[initializeCommand.m_instanceID] = instance;
    }

    if ( dispatchThreadID.x < RootCBV.m_numInitializeCommands_PointLight )
    {
        PointLightInitializeCommand initializeCommand = resourceTable.m_initializeBuffer_PointLight[dispatchThreadID.x];

        LightInstance_PointLight light = ( LightInstance_PointLight )0;

        light.m_shadowMapHandle    = initializeCommand.m_shadowMapHandle;
        light.m_shadowResolutionBits = initializeCommand.m_shadowResolutionBits;

        resourceTable.m_pointLightBuffer[initializeCommand.m_instanceID] = light;
    }

    if ( dispatchThreadID.x < RootCBV.m_numInitializeCommands_SpotLight )
    {
        SpotLightInitializeCommand initializeCommand = resourceTable.m_initializeBuffer_SpotLight[dispatchThreadID.x];

        LightInstance_SpotLight light = ( LightInstance_SpotLight )0;

        light.m_shadowMapHandle    = initializeCommand.m_shadowMapHandle;
        light.m_shadowResolutionBits = initializeCommand.m_shadowResolutionBits;

        resourceTable.m_spotLightBuffer[initializeCommand.m_instanceID] = light;
    }

    if ( dispatchThreadID.x < RootCBV.m_numInitializeCommands_Decal )
    {
        DecalInstanceInitializeCommand initializeCommand = resourceTable.m_initializeBuffer_Decal[dispatchThreadID.x];

        DecalInstance decal = ( DecalInstance )0;

        decal.m_albedoTexture       = initializeCommand.m_albedoTexture;
        decal.m_pbrTexture          = initializeCommand.m_pbrTexture;
        decal.m_normalTexture       = initializeCommand.m_normalTexture;
        decal.m_emissiveTexture     = initializeCommand.m_emissiveTexture;
        decal.m_parallaxTexture     = initializeCommand.m_parallaxTexture;
        decal.m_flags               = initializeCommand.m_flags;
        decal.m_heightOffset        = 128; // 128 is "neutral"

        resourceTable.m_decalBuffer[initializeCommand.m_instanceID] = decal;
    }
}

#endif
