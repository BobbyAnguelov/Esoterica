    // Lights
    //-------------------------------------------------------------------------

    struct HLSL_ALIGN_STRUCT LightInstance_DirectionalLight
    {
        float                               m_maxIntensity;         // Peak intensity (no distance falloff for directional)

        float3                              m_lightDirection;       // Towards the light
        uint                                m_packedTintedColor;    // RGBA8888 = KelvinToRGB(temperature) + tint, use UnpackColor()

        TextureHandle                       m_shadowCascades;
        uint16_t                            m_padding0;
        uint                                m_padding1;
        uint                                m_padding2;

        float4x4                            m_shadowMatrix;

        float4                              m_cascadeOffsets[4];
        float4                              m_cascadeScales[4];
        float4                              m_cascadeSize;

        float4                              m_cascadeTexelWorldSize;
    };

    HLSL_STATIC_ASSERT( sizeof( LightInstance_DirectionalLight ) == 256, "Expected exactly 256 bytes" );

    struct HLSL_ALIGN_STRUCT LightInstance_PointLight
    {
        float                               m_maxIntensity;

        float3                              m_lightPosition;
        float                               m_maxRadius;
        float                               m_falloff;
        uint                                m_packedTintedColor;

        TextureHandle                       m_shadowMapHandle;
        uint16_t                            m_shadowResolutionBits;
    };

    HLSL_STATIC_ASSERT( sizeof( LightInstance_PointLight ) == 32, "Expected exactly 32 bytes" );

    struct HLSL_ALIGN_STRUCT LightInstance_SpotLight
    {
        float                               m_maxIntensity;

        float3                              m_lightPosition;
        float3                              m_lightDirection;
        float                               m_maxRadius;
        float                               m_falloff;
        float                               m_innerConeAngle;
        float                               m_outerConeAngle;
        uint                                m_packedTintedColor;

        TextureHandle                       m_shadowMapHandle;
        uint16_t                            m_shadowResolutionBits;

        float                               m_shadowTangent;

        uint                                m_padding0;
        uint                                m_padding1;

        float4x4                            m_shadowMatrix;
    };

    HLSL_STATIC_ASSERT( sizeof( LightInstance_SpotLight ) == 128, "Expected exactly 128 bytes" );

    //-------------------------------------------------------------------------

    static const float PUNCTUAL_SHADOW_NEAR_PLANE_FRACTION = 0.005F;   // of the light's radius
    static const float PUNCTUAL_SHADOW_NEAR_PLANE_MINIMUM = 0.001F;

    inline float PunctualShadowNearPlane( float maxRadius )
    {
        float const scaledNearPlane = maxRadius * PUNCTUAL_SHADOW_NEAR_PLANE_FRACTION;
        return ( PUNCTUAL_SHADOW_NEAR_PLANE_MINIMUM > scaledNearPlane ) ? PUNCTUAL_SHADOW_NEAR_PLANE_MINIMUM : scaledNearPlane;
    }

    inline float PunctualShadowFarPlane( float maxRadius )
    {
        float const nearPlane = PunctualShadowNearPlane( maxRadius );
        return ( maxRadius > nearPlane * 2.0F ) ? maxRadius : nearPlane * 2.0F;
    }

    inline float PunctualShadowTexelSize( float halfFOVTangent, uint32_t resolution )
    {
        return ( resolution > 0 ) ? ( 2.0F * halfFOVTangent / float( resolution ) ) : 0.0F;
    }

    //-------------------------------------------------------------------------

    static const uint   g_OctahedralShadowNumFaces          = 8;
    static const float  g_OctahedralShadowInverseSqrt3      = 0.57735026919F;
    static const float  g_OctahedralShadowHalfFOVTangent    = 2.4494897427831781F;    // sqrt( 6 )

    #ifndef __cplusplus
    float3 OctahedralShadowFaceSigns( uint faceIndex )
    {
        return float3
        (
            ( ( faceIndex & 1 ) != 0 ) ? -1.0 : 1.0,
            ( ( faceIndex & 2 ) != 0 ) ? -1.0 : 1.0,
            ( ( faceIndex & 4 ) != 0 ) ? -1.0 : 1.0
        );
    }

    float4 ProjectOctahedralShadowFacePosition( uint faceIndex, float3 lightPosition, float3 worldPosition, float nearPlane, float farPlane )
    {
        float3 const signs          = OctahedralShadowFaceSigns( faceIndex );
        float3 const lightVector    = worldPosition - lightPosition;

        float const fold        = ( signs.z < 0.0 ) ? 1.0 : 0.0;
        float const numeratorXZ = fold * signs.x * signs.z;
        float const numeratorYZ = fold * signs.y * signs.z;

        float const depthScale  = nearPlane / ( farPlane - nearPlane );
        float const depthOffset = nearPlane * farPlane / ( farPlane - nearPlane );
        float const axisDepth   = g_OctahedralShadowInverseSqrt3 * dot( signs, lightVector );

        return float4
        (
            g_OctahedralShadowInverseSqrt3 * ( lightVector.x + numeratorXZ * lightVector.z ),
            -g_OctahedralShadowInverseSqrt3 * ( lightVector.y + numeratorYZ * lightVector.z ),
            depthOffset - depthScale * axisDepth,
            axisDepth
        );
    }

    float3 ComputeOctahedralShadowClipDistances( uint faceIndex, float3 lightPosition, float3 worldPosition )
    {
        float3 const signs = OctahedralShadowFaceSigns( faceIndex );
        float3 const lightVector = worldPosition - lightPosition;

        return float3( signs.x * lightVector.x, signs.y * lightVector.y, signs.z * lightVector.z );
    }

    #endif

EE_END_SHADER_TYPES_NAMESPACE

//-------------------------------------------------------------------------

#ifndef __cplusplus

    struct VertexOutput
    {
        float4  m_clipPosition          : SV_POSITION;
        float3  m_worldPosition         : TEXCOORD0;
        float3  m_worldNormal           : TEXCOORD1;
        float4  m_uv                    : TEXCOORD2;
        float4  m_color                 : TEXCOORD3;
    };

    struct MeshVertexOutput : VertexOutput
    {
        float   m_clipDistance0         : SV_ClipDistance0;
        float   m_clipDistance1         : SV_ClipDistance1;
        float   m_clipDistance2         : SV_ClipDistance2;
    };

    struct PrimitiveOutputFlags
    {
        RendererGlobalFlags             m_rendererGlobalFlags               : 6;
        RendererDebugFlags              m_rendererDebugFlags                : 6;
        RendererDebugVisualizationMode  m_rendererDebugVisualizationMode    : 8;
        uint                            m_padding0                          : 12;
    };

    HLSL_STATIC_ASSERT( sizeof( PrimitiveOutputFlags ) == 4, "Exactly 4 bytes expected" );

    struct PrimitiveOutput
    {
        // NOTE: Do not use floats in this structure, pack into uint4 instead.
        uint4   m_data0                                     : TEXCOORD4;
        uint4   m_data1                                     : TEXCOORD5;
        
        PrimitiveOutputFlags    m_primitiveFlags            : TEXCOORD6;
        bool                    m_cullPrimitive             : SV_CullPrimitive;
    
        // TODO: Probably don't need instance index here, pixel shaders are not supposed to fetch instances. But it is useful for debugging.
        void SetInstanceIndex( uint instanceIndex ) { m_data0.x = instanceIndex; }
        uint GetInstanceIndex() { return m_data0.x; }
    
        void SetClusterIndex( uint clusterIndex ) { m_data0.y = clusterIndex; }
        uint GetClusterIndex() { return m_data0.y; }
    
        void SetShaderParametersOffsetIn32ByteBlocks( uint offset ) { m_data0.z = offset; }
        uint GetShaderParametersOffsetIn32ByteBlocks() { return m_data0.z; }
    
        void SetTriangleNormal( float3 triangleNormal ) { m_data1.xyz = uint3( asuint( triangleNormal.x ), asuint( triangleNormal.y ), asuint( triangleNormal.z ) ); }
        float3 GetTriangleNormal() { return float3( asfloat( m_data1.x ), asfloat( m_data1.y ), asfloat( m_data1.z ) ); }
    };

#endif

#endif
