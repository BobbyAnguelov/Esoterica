        uint                            m_drawClusterCountersBuffer : 16;
        uint                            m_padding0                  : 16;

        uint                            m_workBufferOffset;
        uint                            m_numWorkEntries; // Work buffer end - guards the tail of the last chunk

        uint                            m_padding;
    };

