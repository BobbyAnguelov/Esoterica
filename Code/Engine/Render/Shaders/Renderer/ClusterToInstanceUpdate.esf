#include "Engine/Render/Shaders/Renderer/WorldUpdate.esh"
#include "Engine/Render/Shaders/Renderer/CullingRootConstants.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct ClusterToInstanceUpdateResourceTable
{
    StructuredBuffer<MeshInstanceInitializeCommand>  m_initializeBuffer_MeshInstance;
    StructuredBuffer<uint>                           m_clusterToInstanceBufferHandles;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/ClusterToInstanceUpdate.esh"

#ifndef __cplusplus

#define ClusterToInstanceUpdateRootSignature EE_BEGIN_ROOT_SIGNATURE \
                                             ClusterToInstanceUpdateResourceTableRootConstant( "b0", "space=0" )

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_ROOT_CONSTANTS( ClusterToInstanceUpdateResourceTableData, b0, space0 );

[RootSignature( ClusterToInstanceUpdateRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint groupID : SV_GroupID, uint groupThreadID : SV_GroupThreadID )
{
    ClusterToInstanceUpdateResourceTable    resourceTable           = CreateClusterToInstanceUpdateResourceTable( RootConstants );

    MeshInstanceInitializeCommand const     initializeCommand       = resourceTable.m_initializeBuffer_MeshInstance[groupID];

    RWStructuredBuffer<ClusterToInstance>   clusterToInstanceBuffer = GetRWBuffer( NonUniformResourceIndex( resourceTable.m_clusterToInstanceBufferHandles[initializeCommand.m_shaderIndex] ) );

    EE_GROUP_THREAD_MAP( initializeCommand.m_numClusters, 128, {
        ClusterToInstance clusterToInstance;
        clusterToInstance.m_instanceIndex = initializeCommand.m_instanceID;
        clusterToInstance.m_clusterOffset = workIndex;

        clusterToInstanceBuffer[initializeCommand.m_clusterToInstanceOffset + workIndex] = clusterToInstance;
    } )
}

#endif
