
#include "Engine/Render/Shaders/Renderer/RendererTypes.esh"
#include "Engine/Render/Shaders/Renderer/RendererSurfaceShaderLayout.esh"
#include "Engine/Render/Shaders/EngineShader.esh"
#include "Engine/Render/Shaders/MeshInstance.esh"

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_ROOT_CONSTANTS( ClusterCullingRootConstants, b0, space0 );
EE_DECLARE_ROOT_CBV( GlobalParameters, b1, space0 );

[RootSignature( ClusterCullingRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint groupID : SV_GroupID, uint groupThreadID : SV_GroupThreadID, uint3 dispatchThreadID : SV_DispatchThreadID )
{
    const uint                              workEntryIndex           = RootConstants.m_workBufferOffset + groupID * 128 + groupThreadID;
    if ( workEntryIndex >= RootConstants.m_numWorkEntries )
    {
        return;
    }

    RWStructuredBuffer<ClusterCullingWorkEntry> cullingWorkBuffer           = GetRWBuffer( RootConstants.m_cullingWorkBuffer );
    StructuredBuffer<ClusterToInstance>         clusterToInstanceBuffer     = GetBuffer( RootConstants.m_clusterToInstanceBuffer );
    StructuredBuffer<MeshInstance>              meshInstanceBuffer          = GetBuffer( RootConstants.m_instanceBuffer );
    StructuredBuffer<uint64_t>                  instanceVisibilityBuffer    = GetBuffer( RootConstants.m_instanceVisibilityBuffer );
    RWByteAddressBuffer                         drawClusterCountersBuffer   = GetRWBuffer( RootConstants.m_drawClusterCountersBuffer );
    ByteAddressBuffer                           shaderDataBuffer            = GetBuffer( RootCBV.m_shaderDataBuffer );
    StructuredBuffer<MeshInstanceRoot>          meshInstanceRootBuffer      = GetBuffer( RootCBV.m_meshInstanceRootBuffer );
    StructuredBuffer<RenderView>                renderViewBuffer            = GetBuffer( RootCBV.m_renderViewBuffer );
    StructuredBuffer<uint16_t>                  renderViewIndirectionBuffer = GetBuffer( RootCBV.m_renderViewIndirectionBuffer );

    const uint                                  clusterIndex                = cullingWorkBuffer[workEntryIndex].m_clusterIndex;
    const ClusterToInstance                     clusterToInstance           = clusterToInstanceBuffer[clusterIndex];

    const uint                                  instanceIndex               = clusterToInstance.m_instanceIndex;
    const uint                                  localClusterIndex           = clusterToInstance.m_clusterOffset;

    const uint64_t                              instanceMask                = instanceVisibilityBuffer[instanceIndex];

    const MeshInstance                          meshInstance                = meshInstanceBuffer[instanceIndex];
    const MeshInstanceRoot                      meshInstanceRoot            = meshInstance.LoadRoot( meshInstanceRootBuffer );

    ByteAddressBuffer                           meshBuffer                  = GetBuffer( NonUniformResourceIndex( meshInstance.m_meshBuffer ) );
    MeshHeader                                  meshHeader                  = meshBuffer.Load<MeshHeader>( 0 );

    if ( localClusterIndex >= meshHeader.m_numClusters )
    {
        return;
    }

    const bool                                  isSkinned                   = meshInstanceRoot.m_boneOffset != ~0U;

    //-------------------------------------------------------------------------

    float3x4 meshInstanceTransform = ( float3x4 )0;
    float3 clusterCenterGlobal;
    float3 clusterExtentGlobal;
    if ( !isSkinned )
    {
        meshInstanceTransform = meshInstance.ComputeWorldTransform( meshInstanceRoot );

        const uint clusterAddress = GetMeshClusterAddress( localClusterIndex );
        const MeshCluster cluster = meshBuffer.Load<MeshCluster>( clusterAddress );

        float3 clusterAABBMin, clusterAABBMax;
        cluster.GetAABB( clusterAABBMin, clusterAABBMax );

        const float3 clusterCenter = ( clusterAABBMin + clusterAABBMax ) * 0.5;
        const float3 clusterExtent = ( clusterAABBMax - clusterAABBMin ) * 0.5;

        TransformAABB( meshInstanceTransform, clusterCenter, clusterExtent, clusterCenterGlobal, clusterExtentGlobal );
    }

    //-------------------------------------------------------------------------

    uint64_t clusterMask = 0;
    for ( uint viewIndex = 0; viewIndex < RootCBV.m_numActiveRenderViews; ++viewIndex )
    {
        if ( ( instanceMask & ( 1ULL << viewIndex ) ) == 0 )
        {
            continue;
        }

        bool visibleInThisView = true;

        if ( !isSkinned )
        {
            const RenderView renderView = renderViewBuffer[renderViewIndirectionBuffer[viewIndex]];

            float4 viewPlanes[6];
            renderView.ComputeViewPlanes( viewPlanes );

            if ( ( renderView.m_renderViewFlags & RENDER_VIEW_FLAG_SHADOW_FACE ) != 0 )
            {
                visibleInThisView = IsSphereVisible( clusterCenterGlobal, clusterExtentGlobal, renderView.m_shadowLightSphere.xyz, renderView.m_shadowLightSphere.w );
            }
            else
            {
                visibleInThisView = IsFrustumVisible( clusterCenterGlobal, clusterExtentGlobal, viewPlanes );
            }

            if ( visibleInThisView )
            {
            #if 0 // TODO: This causes a lot of issues with punctual shadows
                float4 projectedAABB = 0.0.xxxx;
                if ( renderView.ProjectBox( clusterCenterGlobal, clusterExtentGlobal, projectedAABB ) )
                {
                    const float width  = ( projectedAABB.z - projectedAABB.x ) * renderView.m_renderTargetSize.x;
                    const float height = ( projectedAABB.w - projectedAABB.y ) * renderView.m_renderTargetSize.y;

                    // Size is less than 2 pixels -> cull
                    if ( width < 2.0 && height < 2.0 )
                    {
                        visibleInThisView = false;
                    }
                }
            #endif
            }
        }

        if ( visibleInThisView )
        {
            clusterMask |= 1ULL << viewIndex;
        }
    }

    //-------------------------------------------------------------------------
    
    if ( clusterMask != 0 )
    {
        const ShaderParameters shaderParameters = shaderDataBuffer.Load<ShaderParameters>( meshInstance.m_shaderParametersOffsetIn32ByteBlocks * 32 );
        const uint             baseBucket       = GetBucketTypeForView( shaderParameters, false );

        for ( uint viewIndex = 0; viewIndex < RootCBV.m_numActiveRenderViews; ++viewIndex )
        {
            if ( clusterMask & ( 1ULL << viewIndex ) )
            {
                const bool depthOnlyView = ( renderViewBuffer[renderViewIndirectionBuffer[viewIndex]].m_renderViewFlags & RENDER_VIEW_FLAG_DEPTH_ONLY ) != 0;
                const uint bucket = ( depthOnlyView && baseBucket == 2 ) ? 0 : baseBucket;

                drawClusterCountersBuffer.InterlockedAdd( ( viewIndex * EE_NUM_RENDER_BUCKETS_PER_SHADER_PER_VIEW + bucket ) * 4, 1 );
            }
        }
    }

    cullingWorkBuffer[workEntryIndex].m_visibilityMaskLow  = uint( clusterMask & 0xFFFFFFFFULL );
    cullingWorkBuffer[workEntryIndex].m_visibilityMaskHigh = uint( clusterMask >> 32 );
}

