
#ifndef _WORLD_UPDATE_ESH_
#define _WORLD_UPDATE_ESH_

#include "Engine/Render/Shaders/Renderer/RendererTypes.esh"
#include "Engine/Render/Shaders/Transform.esh"
#include "Engine/Render/Shaders/MeshInstance.esh"

#ifdef __cplusplus
#include "Base/Math/Math.h"
#include "Base/Math/Transform.h"
#endif

EE_BEGIN_SHADER_TYPES_NAMESPACE

struct HLSL_ALIGN_STRUCT MeshInstanceInitializeCommand
{
    uint                    m_instanceID;
    uint                    m_instanceHidden           : 1;
    uint                    m_reservedFlags            : 31;
    uint16_t                m_meshBuffer;
    uint16_t                m_shaderIndex;
    uint                    m_rootIndex;
    uint                    m_clusterToInstanceOffset;
    uint                    m_lodMask;
    uint                    m_shaderParametersOffsetIn32ByteBlocks;
    uint                    m_numClusters;
};

HLSL_STATIC_ASSERT( sizeof( MeshInstanceInitializeCommand ) == 32, "Expected exactly 32 bytes" );

struct HLSL_ALIGN_STRUCT MeshInstanceTransformUpdateCommand
{
    uint                    m_instanceID;
    float3x4                m_transform;
    
    uint                    m_shaderIndex;
    uint                    m_padding1;
    uint                    m_padding2;
};

HLSL_STATIC_ASSERT( sizeof( MeshInstanceTransformUpdateCommand ) == 64, "Expected exactly 64 bytes" );

struct HLSL_ALIGN_STRUCT MeshInstanceRootUpdateCommand
{
    uint                    m_instanceID;
    float3x4                m_transform;

    // Compressed world bounds: 12-bit shared exponent + six 14-bit signed mantissas.
    // The AABB center is stored relative to the transform origin.
    CompressedAABB           m_packedAABB;

    #ifdef __cplusplus
    void EncodeWorldAABB( EE::Float3 worldAABBCenter, EE::Float3 worldAABBHalfExtents, EE::Float3 worldOrigin )
    {
        m_packedAABB = CompressAABB( worldAABBCenter, worldAABBHalfExtents, worldOrigin );
    }
    #endif
};

HLSL_STATIC_ASSERT( sizeof( MeshInstanceRootUpdateCommand ) == 64, "Expected exactly 64 bytes" );

//-------------------------------------------------------------------------


struct HLSL_ALIGN_STRUCT RenderViewUpdateCommand
{
    RenderView              m_renderView;
    uint                    m_deviceRenderViewIndex;
    uint                    m_padding0;
    uint                    m_padding1;
    uint                    m_padding2;
};

HLSL_STATIC_ASSERT( sizeof( RenderViewUpdateCommand ) == 384, "Expected exactly 384 bytes" );
HLSL_STATIC_ASSERT( ( sizeof( RenderViewUpdateCommand ) % 32 ) == 0, "Write combined copies need 32 byte aligned elements" );

//-------------------------------------------------------------------------

struct HLSL_ALIGN_STRUCT DirectionalLightUpdateCommand
{
    uint                                m_instanceID;
    uint                                m_padding0;
    uint                                m_padding1;
    uint                                m_padding2;
    
    float                               m_maxIntensity;         // Peak intensity (no distance falloff for directional)

    float3                              m_lightDirection;       // Towards the light
    uint                                m_packedTintedColor;    // RGBA8888 = KelvinToRGB(temperature) + tint, use UnpackColor()

    TextureHandle                       m_shadowCascades;
    uint16_t                            m_padding3;
    uint                                m_padding4;
    uint                                m_padding5;

    float4x4                            m_shadowMatrix;

    float4                              m_cascadeOffsets[4];
    float4                              m_cascadeScales[4];
    float4                              m_cascadeSize;
};

HLSL_STATIC_ASSERT( sizeof( DirectionalLightUpdateCommand ) == 256, "Expected exactly 256 bytes" );

//-------------------------------------------------------------------------

struct HLSL_ALIGN_STRUCT PointLightInitializeCommand
{
    uint                    m_instanceID;
    uint16_t                m_shadowMapHandle;
    uint16_t                m_shadowResolutionBits;
};

HLSL_STATIC_ASSERT( sizeof( PointLightInitializeCommand ) == 8, "Expected exactly 8 bytes" );

struct HLSL_ALIGN_STRUCT PointLightTransformUpdateCommand
{
    uint                    m_instanceID;
    float                   m_maxIntensity;
    float3                  m_lightPosition;
    float                   m_maxRadius;
    float                   m_falloff;
    uint                    m_packedTintedColor;
};

HLSL_STATIC_ASSERT( sizeof( PointLightTransformUpdateCommand ) == 32, "Expected exactly 32 bytes" );

//-------------------------------------------------------------------------

struct HLSL_ALIGN_STRUCT SpotLightInitializeCommand
{
    uint                    m_instanceID;
    uint16_t                m_shadowMapHandle;
    uint16_t                m_shadowResolutionBits;
};

HLSL_STATIC_ASSERT( sizeof( SpotLightInitializeCommand ) == 8, "Expected exactly 8 bytes" );

struct HLSL_ALIGN_STRUCT SpotLightTransformUpdateCommand
{
    uint                    m_instanceID;
    float                   m_maxIntensity;
    uint16_t                m_paddingFlags;
    uint16_t                m_padding0;
    float3                  m_lightPosition;
    float3                  m_lightDirection;
    float                   m_maxRadius;
    float                   m_falloff;
    float                   m_innerConeAngle;
    float                   m_outerConeAngle;
    uint                    m_packedTintedColor;
    uint                    m_padding1;
    uint                    m_padding2;

    float4x4                m_shadowMatrix;
};

HLSL_STATIC_ASSERT( sizeof( SpotLightTransformUpdateCommand ) == 128, "Expected exactly 128 bytes" );

//-------------------------------------------------------------------------

struct HLSL_ALIGN_STRUCT SkinningTransformUpdateCommand
{
    float4                  m_compressedData0;
    float4                  m_compressedData1;
    
    #ifndef __cplusplus
    inline uint DecodeInstanceID()
    {
        return asuint( m_compressedData0.w );
    }
    
    inline SkinningTransform DecodeSkinningTransform()
    {
        SkinningTransform result;
        result.m_rotation.xyz       = m_compressedData0.xyz;
        result.m_rotation.w         = sqrt( 1.0 - result.m_rotation.x * result.m_rotation.x - result.m_rotation.y * result.m_rotation.y - result.m_rotation.z * result.m_rotation.z );
        result.m_translationScale   = m_compressedData1;
        return result;
    }
    #else
    inline void EncodeSkinningTransform( uint32_t instanceID, EE::Transform const& transform )
    {
        EE::Quaternion rotation = transform.GetRotation();
        EE_ASSERT( rotation.IsNormalized() );

        if ( rotation.GetW() < 0.0F )
        {
            rotation.Conjugate();
        }
    
        m_compressedData0[0] = rotation.GetX();
        m_compressedData0[1] = rotation.GetY();
        m_compressedData0[2] = rotation.GetZ();
        memcpy( &m_compressedData0[3], &instanceID, sizeof( instanceID ) );
    
        transform.GetTranslationAndScale().Store( m_compressedData1 );
    }
    #endif
};

//-------------------------------------------------------------------------

struct HLSL_ALIGN_STRUCT WorldUpdateConstants
{
    uint                    m_numInitializeCommands_MeshInstance;
    uint                    m_numInitializeCommands_PointLight;
    uint                    m_numInitializeCommands_SpotLight;

    uint                    m_numUpdateCommands_MeshInstanceRoot;
    uint                    m_numUpdateCommands_MeshInstance;
    uint                    m_numUpdateCommands_DirectionalLight;
    uint                    m_numUpdateCommands_PointLight;
    uint                    m_numUpdateCommands_SpotLight;
    uint                    m_numUpdateCommands_SkinningTransform;
    uint                    m_numUpdateCommands_RenderView;

    uint2                   m_padding;
};

EE_END_SHADER_TYPES_NAMESPACE

#endif
