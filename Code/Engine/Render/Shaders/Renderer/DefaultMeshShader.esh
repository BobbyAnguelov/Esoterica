
#include "Engine/Render/Shaders/Renderer/RendererTypes.esh"
#include "Engine/Render/Shaders/EngineShader.esh"
#include "Engine/Render/Shaders/MeshInstance.esh"
#include "Engine/Render/Shaders/Picking/Picking.esh"

EE_DECLARE_ROOT_CONSTANTS( DrawRootConstants, b0, space0 );
EE_DECLARE_ROOT_CBV( GlobalParameters, b1, space0 );

groupshared float4 gsClipVertices[MAX_CLUSTER_VERTICES];
groupshared float3 gsWorldVertices[MAX_CLUSTER_VERTICES];

#if EE_DEVELOPMENT_TOOLS
groupshared uint gsNumIntersections;
groupshared uint gsIntersectionDistanceMin;
#endif

[RootSignature( DrawRootSignature )]
[NumThreads( MESH_SHADER_DISPATCH_COUNT, 1, 1 )]
[OutputTopology( "triangle" )]
void MS_main
( 
    uint                                groupThreadID   : SV_GroupThreadID, 
    uint3                               groupID         : SV_GroupID,
    out indices     uint3               outTriangles[MAX_CLUSTER_TRIANGLES],
    out primitives  PrimitiveOutput     outPrimitives[MAX_CLUSTER_TRIANGLES],
    out vertices    MeshVertexOutput    outVertices[MAX_CLUSTER_VERTICES] 
)
{
    #if EE_DEVELOPMENT_TOOLS
    if ( groupThreadID == 0 )
    {
        gsNumIntersections = 0;
        gsIntersectionDistanceMin = asuint( 1.5E+10 );
    }
    #endif
    
    StructuredBuffer<RenderView>        renderViewBuffer            = GetBuffer( RootCBV.m_renderViewBuffer );
    StructuredBuffer<uint16_t>          renderViewIndirectionBuffer = GetBuffer( RootCBV.m_renderViewIndirectionBuffer );
    StructuredBuffer<MeshInstance>      meshInstanceBuffer          = GetBuffer( RootConstants.m_instanceBuffer );
    StructuredBuffer<MeshInstanceRoot>  meshInstanceRootBuffer      = GetBuffer( RootCBV.m_meshInstanceRootBuffer );
    StructuredBuffer<SkinningTransform> skinningTransformBuffer     = GetBuffer( RootCBV.m_skinningTransformBuffer ); 

    StructuredBuffer<ClusterToInstance> clusterToInstanceBuffer     = GetBuffer( RootConstants.m_clusterToInstanceBuffer );
    StructuredBuffer<uint>              drawClusterBuffer           = GetBuffer( RootConstants.m_drawClusterBuffer );

    const ClusterToInstance             clusterToInstance           = clusterToInstanceBuffer[drawClusterBuffer[RootConstants.m_drawClusterBufferOffset + groupID.x]];
    const uint                          instanceIndex               = clusterToInstance.m_instanceIndex;
    const uint                          clusterOffset               = clusterToInstance.m_clusterOffset;
    
    const MeshInstance                  meshInstance                = meshInstanceBuffer[instanceIndex];
    const RenderView                    renderView                  = renderViewBuffer[renderViewIndirectionBuffer[RootConstants.m_renderViewIndex]];

    const bool                          isShadowFace                = ( renderView.m_renderViewFlags & RENDER_VIEW_FLAG_SHADOW_FACE ) != 0;
    const uint                          shadowFaceIndex             = groupID.y;
    
    ByteAddressBuffer                   meshBuffer                  = GetBuffer( NonUniformResourceIndex( meshInstance.m_meshBuffer ) );
    const uint                          clusterAddress              = GetMeshClusterAddress( clusterOffset );
    const MeshCluster                   cluster                     = meshBuffer.Load<MeshCluster>( clusterAddress );
    
    ByteAddressBuffer                   shaderDataBuffer            = GetBuffer( RootCBV.m_shaderDataBuffer );

    //-------------------------------------------------------------------------
    
    #if EE_DEVELOPMENT_TOOLS
    RWByteAddressBuffer                 instancePickingDistancesBuffer = GetBuffer( RootCBV.m_instancePickingDistancesBuffer );
    #endif
    
    //-------------------------------------------------------------------------

    uint numClusterVertices = min( cluster.m_numVertices + 1, MAX_CLUSTER_VERTICES );
    uint numClusterTriangles = min( cluster.m_numTriangles + 1, MAX_CLUSTER_TRIANGLES );

    SetMeshOutputCounts( numClusterVertices, numClusterTriangles );

    // Unpack cluster data
    //-------------------------------------------------------------------------
    
    MeshInstanceRoot    meshInstanceRoot        = meshInstance.LoadRoot( meshInstanceRootBuffer );
    float3x4            meshInstanceTransform   = meshInstance.ComputeWorldTransform( meshInstanceRoot );

    ShaderParameters    shaderParameters        = shaderDataBuffer.Load<ShaderParameters>( meshInstance.m_shaderParametersOffsetIn32ByteBlocks * 32 );
    bool                isDoubleSided           = ( shaderParameters.m_shaderFlags & EE_SHADER_FLAG_TWO_SIDED ) != 0;
    RendererGlobalFlags rendererGlobalFlags     = RootCBV.m_rendererGlobalFlags;

    // Shadow map views must not evaluate lighting, when alpha test is enabled this runs the full pixel shader.
    if ( ( renderView.m_renderViewLayerFlags & RENDER_VIEW_LAYER_FLAG_SHADOW_MAP ) != 0 )
    {
        rendererGlobalFlags |= RENDERER_GLOBAL_FLAG_DISABLE_LIGHTING;
    }
    
    // Special case - global environment map view shouldn't compute lighting
    float3 worldPositionOffset = 0.0.xxx;
    if ( ( meshInstanceRoot.m_renderViewLayerFlags & RENDER_VIEW_LAYER_FLAG_GLOBAL_ENVIRONMENT_MAP ) )
    {
        rendererGlobalFlags |= RENDERER_GLOBAL_FLAG_DISABLE_LIGHTING;
        
        // Envmap geometry is rendered in other views as well, but in that case it is always relative to camera
        if ( ( renderView.m_renderViewLayerFlags & RENDER_VIEW_LAYER_FLAG_GLOBAL_ENVIRONMENT_MAP ) == 0 )
        {
            worldPositionOffset = RootCBV.m_cameraPosition.xyz;
        }
    }

    // Shade vertices
    //-------------------------------------------------------------------------

    // TODO: Compute winding during culling pass
    bool        flipWinding             = determinant( ( float3x3 )meshInstanceTransform ) < 0.0;
    
    if ( groupThreadID < numClusterVertices )
    {
        precise float3 vertexPosition = LoadClusterVertexPosition( meshBuffer, cluster, groupThreadID );

        uint const attributeBaseAddress = cluster.GetDataOffsetInBytes();

        uint const normalAddress = attributeBaseAddress + cluster.GetVertexNormalOffset( groupThreadID );
        float3 vertexNormal = LoadClusterVertexNormal( meshBuffer, normalAddress );

        float2 uv0 = 0.0.xx;
        if ( cluster.m_numTextureCoordinateAttributes > 0 )
        {
            uv0 = meshBuffer.Load<TextureCoordinateAttribute>( attributeBaseAddress + cluster.GetVertexUVOffset( 0, groupThreadID ) );
        }

        float2 uv1 = 0.0.xx;
        if ( cluster.m_numTextureCoordinateAttributes > 1 )
        {
            uv1 = meshBuffer.Load<TextureCoordinateAttribute>( attributeBaseAddress + cluster.GetVertexUVOffset( 1, groupThreadID ) );
        }

        float4 vertexColor = 1.0.xxxx;
        if ( cluster.m_numColorAttributes > 0 )
        {
            vertexColor = UnpackColor( meshBuffer.Load<VertexColorAttribute>( attributeBaseAddress + cluster.GetVertexColorOffset( 0, groupThreadID ) ) );
        }
        
        precise float3 localPosition = mul( meshInstance.m_localTransform, float4( vertexPosition, 1.0 ) ).xyz;
        float3 localNormal = mul( Adjugate( meshInstance.m_localTransform ), vertexNormal );
        
        if ( meshInstanceRoot.m_boneOffset != ~0U )
        {
            float3 skinnedPosition = 0.0.xxx;
            float3 skinnedNormal = 0.0.xxx;
            
            [loop]
            for ( uint skinningAttributeIndex = 0; skinningAttributeIndex < cluster.m_numSkinningAttributes; ++skinningAttributeIndex )
            {
                SkinningAttribute skinningAttribute = meshBuffer.Load<SkinningAttribute>( attributeBaseAddress + cluster.GetSkinningAttributeOffset( skinningAttributeIndex, groupThreadID ) );
            
                [unroll( 4 )]
                for ( uint boneIndex = 0; boneIndex < 4; ++boneIndex )
                {
                    int boneTransformIndex = skinningAttribute.m_boneIndices[boneIndex];
                    float boneWeight = skinningAttribute.m_boneWeights[boneIndex];
                
                    if ( boneTransformIndex != -1 )
                    {
                        SkinningTransform skinningTransform = skinningTransformBuffer[meshInstanceRoot.m_boneOffset + boneTransformIndex];
                
                        skinnedPosition += skinningTransform.TransformPoint( localPosition ) * boneWeight;
                        skinnedNormal += skinningTransform.TransformNormal( localNormal ) * boneWeight;
                    }
                }
            }
            
            localPosition = skinnedPosition;
            localNormal = normalize( skinnedNormal );
        }
        
        if ( flipWinding )
        {
            localNormal = -localNormal;
        }
        
        precise float3 worldPosition = mul( meshInstanceRoot.m_rootTransform, float4( localPosition, 1.0 ) ).xyz + worldPositionOffset;
        precise float4 clipPosition;

        MeshVertexOutput output;
        if ( isShadowFace )
        {
            float3 const lightPosition      = renderView.m_shadowLightSphere.xyz;
            float const shadowNearPlane     = PunctualShadowNearPlane( renderView.m_shadowLightSphere.w );
            float const shadowFarPlane      = PunctualShadowFarPlane( renderView.m_shadowLightSphere.w );

            clipPosition = ProjectOctahedralShadowFacePosition( shadowFaceIndex, lightPosition, worldPosition, shadowNearPlane, shadowFarPlane );

            float3 const clipDistances      = ComputeOctahedralShadowClipDistances( shadowFaceIndex, lightPosition, worldPosition );
            output.m_clipDistance0          = clipDistances.x;
            output.m_clipDistance1          = clipDistances.y;
            output.m_clipDistance2          = clipDistances.z;
        }
        else
        {
            clipPosition = mul( renderView.m_viewProjectionMatrix, float4( worldPosition, 1.0 ) );

            output.m_clipDistance0 = 1.0;
            output.m_clipDistance1 = 1.0;
            output.m_clipDistance2 = 1.0;
        }

        output.m_clipPosition   = clipPosition;
        output.m_worldPosition  = worldPosition;
        output.m_worldNormal    = normalize( mul( Adjugate( meshInstanceRoot.m_rootTransform ), localNormal ) );
        output.m_uv             = float4( uv0, uv1 );
        output.m_color          = vertexColor;
        
        //#define DEBUG_CLUSTERS
        #ifdef DEBUG_CLUSTERS
        output.m_color = float4(
            float( groupID.x & 1 ),
            float( groupID.x & 3 ) / 4,
            float( groupID.x & 7 ) / 8,
            1.0 );
        #endif

        gsClipVertices[groupThreadID]   = output.m_clipPosition;
        gsWorldVertices[groupThreadID]  = output.m_worldPosition;
        outVertices[groupThreadID]      = output;
    }

    GroupMemoryBarrierWithGroupSync();

    if ( groupThreadID < numClusterTriangles )
    {
        uint3 triangleIndices = LoadMeshClusterTriangle( meshBuffer, cluster, groupThreadID );

        if ( !isDoubleSided )
        {
            if ( renderView.m_renderViewFlags & RENDER_VIEW_FLAG_FLIP_WINDING )
            {
                triangleIndices = triangleIndices.zyx;
            }
                
            if ( flipWinding )
            {
                triangleIndices = triangleIndices.zyx;
            }
        }

        outTriangles[groupThreadID] = triangleIndices;

        float4 clipVertices[3];
        clipVertices[0] = gsClipVertices[triangleIndices.x];
        clipVertices[1] = gsClipVertices[triangleIndices.y];
        clipVertices[2] = gsClipVertices[triangleIndices.z];
        
        float3 worldVertices[3];
        worldVertices[0] = gsWorldVertices[triangleIndices.x];
        worldVertices[1] = gsWorldVertices[triangleIndices.y];
        worldVertices[2] = gsWorldVertices[triangleIndices.z];
        
        float3 triangleNormal = normalize( cross( worldVertices[1] - worldVertices[0], worldVertices[2] - worldVertices[0] ) );
            
        PrimitiveOutput output = ( PrimitiveOutput ) 0;
        output.m_cullPrimitive      = IsTriangleCulled( clipVertices, renderView.m_renderTargetSize.xy, isDoubleSided );
        output.SetInstanceIndex( instanceIndex );
        output.SetClusterIndex( clusterOffset );
        output.SetShaderParametersOffsetIn32ByteBlocks( meshInstance.m_shaderParametersOffsetIn32ByteBlocks );
        output.SetTriangleNormal( triangleNormal );
            
        output.m_primitiveFlags.m_rendererGlobalFlags               = rendererGlobalFlags;
        output.m_primitiveFlags.m_rendererDebugFlags                = RootCBV.m_rendererDebugFlags;
        output.m_primitiveFlags.m_rendererDebugVisualizationMode    = RootCBV.m_rendererDebugVisualizationMode;
        outPrimitives[groupThreadID] = output;
        
        #if EE_DEVELOPMENT_TOOLS
        if ( RootCBV.m_pickingEnabled && ( RootConstants.m_renderViewIndex == RootCBV.m_mainCameraRenderView ) )
        {
            float hitDistance = 0.0;
            if ( PickTriangleClipSpace( RootCBV.m_pickingInput.xy, RootCBV.m_pickingInput.z, clipVertices[0], clipVertices[1], clipVertices[2], hitDistance ) )
            {
                InterlockedAdd( gsNumIntersections, 1 );
                InterlockedMin( gsIntersectionDistanceMin, asuint( hitDistance ) );
            }
        }
        #endif
    }
    
    #if EE_DEVELOPMENT_TOOLS
    GroupMemoryBarrierWithGroupSync();

    if ( ( groupThreadID == 0 ) && ( gsNumIntersections > 0 ) )
    {
        instancePickingDistancesBuffer.InterlockedMin( meshInstance.m_meshInstanceRootIndex * 4, gsIntersectionDistanceMin );
    }
    #endif
}
