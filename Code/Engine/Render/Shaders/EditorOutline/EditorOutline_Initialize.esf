#include "Base/Render/RHI.esh"
#include "Engine/Render/Shaders/CommonSamplers.esh"
#include "Engine/Render/Shaders/FullscreenTriangle.esh"
#include "Engine/Render/Shaders/EditorOutline/EditorOutline_Common.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct EditorOutlineInitializeResourceTable
{
    Texture2D<uint>             m_objectIDTexture;

    float4                      m_targetSize;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/EditorOutline_Initialize.esh"

#ifndef __cplusplus

ESF_PARAMETER string ShaderType = "Surface";

#define EditorOutlineInitializeRootSignature      EE_BEGIN_ROOT_SIGNATURE \
                                                  EditorOutlineInitializeResourceTableRootConstant( "b0", "space=0" )

EE_DECLARE_ROOT_CONSTANTS( EditorOutlineInitializeResourceTableData, b0, space0 );

[RootSignature( EditorOutlineInitializeRootSignature )]
float2 PS_main( FullscreenTriangleVertexOutput input ) : SV_Target
{
    EditorOutlineInitializeResourceTable resourceTable = CreateEditorOutlineInitializeResourceTable( RootConstants );

    uint2 textureSize = uint2( resourceTable.m_targetSize.xy );

    int2 centerPixel = int2( input.m_position.xy );
    uint centerObjectID = resourceTable.m_objectIDTexture.Load( uint3( uint2( centerPixel ), 0 ) ).x;

    uint neighborObjectID = 0;
    int2 neighborPixel = int2( 0, 0 );

    neighborPixel = clamp( centerPixel + int2( -1, 0 ), int2( 0, 0 ), int2( textureSize ) - 1 );
    neighborObjectID = resourceTable.m_objectIDTexture.Load( uint3( uint2( neighborPixel ), 0 ) ).x;
    if ( neighborObjectID != centerObjectID )
    {
        return input.m_position.xy / EditorOutline_SeedCoordinateScale;
    }

    neighborPixel = clamp( centerPixel + int2( 1, 0 ), int2( 0, 0 ), int2( textureSize ) - 1 );
    neighborObjectID = resourceTable.m_objectIDTexture.Load( uint3( uint2( neighborPixel ), 0 ) ).x;
    if ( neighborObjectID != centerObjectID )
    {
        return input.m_position.xy / EditorOutline_SeedCoordinateScale;
    }

    neighborPixel = clamp( centerPixel + int2( 0, -1 ), int2( 0, 0 ), int2( textureSize ) - 1 );
    neighborObjectID = resourceTable.m_objectIDTexture.Load( uint3( uint2( neighborPixel ), 0 ) ).x;
    if ( neighborObjectID != centerObjectID )
    {
        return input.m_position.xy / EditorOutline_SeedCoordinateScale;
    }

    neighborPixel = clamp( centerPixel + int2( 0, 1 ), int2( 0, 0 ), int2( textureSize ) - 1 );
    neighborObjectID = resourceTable.m_objectIDTexture.Load( uint3( uint2( neighborPixel ), 0 ) ).x;
    if ( neighborObjectID != centerObjectID )
    {
        return input.m_position.xy / EditorOutline_SeedCoordinateScale;
    }

    neighborPixel = clamp( centerPixel + int2( -1, -1 ), int2( 0, 0 ), int2( textureSize ) - 1 );
    neighborObjectID = resourceTable.m_objectIDTexture.Load( uint3( uint2( neighborPixel ), 0 ) ).x;
    if ( neighborObjectID != centerObjectID )
    {
        return input.m_position.xy / EditorOutline_SeedCoordinateScale;
    }

    neighborPixel = clamp( centerPixel + int2( 1, -1 ), int2( 0, 0 ), int2( textureSize ) - 1 );
    neighborObjectID = resourceTable.m_objectIDTexture.Load( uint3( uint2( neighborPixel ), 0 ) ).x;
    if ( neighborObjectID != centerObjectID )
    {
        return input.m_position.xy / EditorOutline_SeedCoordinateScale;
    }

    neighborPixel = clamp( centerPixel + int2( -1, 1 ), int2( 0, 0 ), int2( textureSize ) - 1 );
    neighborObjectID = resourceTable.m_objectIDTexture.Load( uint3( uint2( neighborPixel ), 0 ) ).x;
    if ( neighborObjectID != centerObjectID )
    {
        return input.m_position.xy / EditorOutline_SeedCoordinateScale;
    }

    neighborPixel = clamp( centerPixel + int2( 1, 1 ), int2( 0, 0 ), int2( textureSize ) - 1 );
    neighborObjectID = resourceTable.m_objectIDTexture.Load( uint3( uint2( neighborPixel ), 0 ) ).x;
    if ( neighborObjectID != centerObjectID )
    {
        return input.m_position.xy / EditorOutline_SeedCoordinateScale;
    }

    return float2( 1.0, 1.0 );
}

#endif
