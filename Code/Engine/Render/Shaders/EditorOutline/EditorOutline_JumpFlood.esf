#include "Base/Render/RHI.esh"
#include "Engine/Render/Shaders/CommonSamplers.esh"
#include "Engine/Render/Shaders/FullscreenTriangle.esh"
#include "Engine/Render/Shaders/EditorOutline/EditorOutline_Common.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct EditorOutlineJumpFloodResourceTable
{
    Texture2D                   m_inputTexture;

    uint                        m_stepSize;
    float4                      m_screenSize;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/EditorOutline_JumpFlood.esh"

#ifndef __cplusplus

ESF_PARAMETER string ShaderType = "Surface";

#define EditorOutlineJumpFloodRootSignature       EE_BEGIN_ROOT_SIGNATURE \
                                                  EditorOutlineJumpFloodResourceTableRootConstant( "b0", "space=0" )

EE_DECLARE_ROOT_CONSTANTS( EditorOutlineJumpFloodResourceTableData, b0, space0 );

[RootSignature( EditorOutlineJumpFloodRootSignature )]
float2 PS_main( FullscreenTriangleVertexOutput input ) : SV_Target
{
    EditorOutlineJumpFloodResourceTable resourceTable = CreateEditorOutlineJumpFloodResourceTable( RootConstants );
    SamplerState pointSampler = GetPointClampSampler();

    float2 bestSeed = resourceTable.m_inputTexture.SampleLevel( pointSampler, input.m_uv, 0 ).xy;
    float bestDistance = length( round( bestSeed * EditorOutline_SeedCoordinateScale ) - input.m_position.xy );

    float2 neighborSeed = float2( 0.0, 0.0 );
    float neighborDistance = 0.0;

    neighborSeed = resourceTable.m_inputTexture.SampleLevel( pointSampler, input.m_uv + float2( -1.0, 0.0 ) * resourceTable.m_screenSize.zw * resourceTable.m_stepSize, 0 ).xy;
    neighborDistance = length( round( neighborSeed * EditorOutline_SeedCoordinateScale ) - input.m_position.xy );
    if ( neighborDistance < bestDistance )
    {
        bestDistance = neighborDistance;
        bestSeed = neighborSeed;
    }

    neighborSeed = resourceTable.m_inputTexture.SampleLevel( pointSampler, input.m_uv + float2( 1.0, 0.0 ) * resourceTable.m_screenSize.zw * resourceTable.m_stepSize, 0 ).xy;
    neighborDistance = length( round( neighborSeed * EditorOutline_SeedCoordinateScale ) - input.m_position.xy );
    if ( neighborDistance < bestDistance )
    {
        bestDistance = neighborDistance;
        bestSeed = neighborSeed;
    }

    neighborSeed = resourceTable.m_inputTexture.SampleLevel( pointSampler, input.m_uv + float2( 0.0, -1.0 ) * resourceTable.m_screenSize.zw * resourceTable.m_stepSize, 0 ).xy;
    neighborDistance = length( round( neighborSeed * EditorOutline_SeedCoordinateScale ) - input.m_position.xy );
    if ( neighborDistance < bestDistance )
    {
        bestDistance = neighborDistance;
        bestSeed = neighborSeed;
    }

    neighborSeed = resourceTable.m_inputTexture.SampleLevel( pointSampler, input.m_uv + float2( 0.0, 1.0 ) * resourceTable.m_screenSize.zw * resourceTable.m_stepSize, 0 ).xy;
    neighborDistance = length( round( neighborSeed * EditorOutline_SeedCoordinateScale ) - input.m_position.xy );
    if ( neighborDistance < bestDistance )
    {
        bestDistance = neighborDistance;
        bestSeed = neighborSeed;
    }

    neighborSeed = resourceTable.m_inputTexture.SampleLevel( pointSampler, input.m_uv + float2( -1.0, -1.0 ) * resourceTable.m_screenSize.zw * resourceTable.m_stepSize, 0 ).xy;
    neighborDistance = length( round( neighborSeed * EditorOutline_SeedCoordinateScale ) - input.m_position.xy );
    if ( neighborDistance < bestDistance )
    {
        bestDistance = neighborDistance;
        bestSeed = neighborSeed;
    }

    neighborSeed = resourceTable.m_inputTexture.SampleLevel( pointSampler, input.m_uv + float2( 1.0, -1.0 ) * resourceTable.m_screenSize.zw * resourceTable.m_stepSize, 0 ).xy;
    neighborDistance = length( round( neighborSeed * EditorOutline_SeedCoordinateScale ) - input.m_position.xy );
    if ( neighborDistance < bestDistance )
    {
        bestDistance = neighborDistance;
        bestSeed = neighborSeed;
    }

    neighborSeed = resourceTable.m_inputTexture.SampleLevel( pointSampler, input.m_uv + float2( -1.0, 1.0 ) * resourceTable.m_screenSize.zw * resourceTable.m_stepSize, 0 ).xy;
    neighborDistance = length( round( neighborSeed * EditorOutline_SeedCoordinateScale ) - input.m_position.xy );
    if ( neighborDistance < bestDistance )
    {
        bestDistance = neighborDistance;
        bestSeed = neighborSeed;
    }

    neighborSeed = resourceTable.m_inputTexture.SampleLevel( pointSampler, input.m_uv + float2( 1.0, 1.0 ) * resourceTable.m_screenSize.zw * resourceTable.m_stepSize, 0 ).xy;
    neighborDistance = length( round( neighborSeed * EditorOutline_SeedCoordinateScale ) - input.m_position.xy );
    if ( neighborDistance < bestDistance )
    {
        bestDistance = neighborDistance;
        bestSeed = neighborSeed;
    }

    return bestSeed;
}

#endif
