
#ifndef _MESH_DATA_ESH_
#define _MESH_DATA_ESH_

#include "Base/Render/RHI.esh"
#include "Engine/Render/Shaders/CommonPacking.esh"

#ifndef __cplusplus
    // These defines have to match the corresponding MeshData.h constants!
    #define MAX_CLUSTER_VERTICES 64
    #define MAX_CLUSTER_TRIANGLES 64
    #define TRIANGLE_INDEX_BITS 6

    // Dispatch count is set to max cluster vertices to achieve optimal CU utilization.
    // Triangle indices are filled with an unrolled loop while each vertex is shaded exactly once by one thread in the group.
    #define MESH_SHADER_DISPATCH_COUNT MAX_CLUSTER_VERTICES
#endif

EE_BEGIN_SHADER_TYPES_NAMESPACE

    struct HLSL_ALIGN_STRUCT SkinningAttribute
    {
        int4                            m_boneIndices;
        float4                          m_boneWeights;
    };

    HLSL_STATIC_ASSERT( sizeof( SkinningAttribute ) == 32, "Expected to be exactly 32 bytes" );

    typedef int16_t3 VertexNormalAttribute;
    HLSL_STATIC_ASSERT( sizeof( VertexNormalAttribute ) == 6, "Expected to be exactly 6 bytes" );

    typedef float2 TextureCoordinateAttribute;
    HLSL_STATIC_ASSERT( sizeof( TextureCoordinateAttribute ) == 8, "Expected to be exactly 8 bytes" );

    typedef uint32_t VertexColorAttribute;
    HLSL_STATIC_ASSERT( sizeof( VertexColorAttribute ) == 4, "Expected to be exactly 4 bytes" );

    struct MeshCluster
    {
        int32_t                         m_anchorX : 24;
        uint32_t                        m_numVertices : 6;                      // Stored as ( count - 1 ), max 64 vertices per cluster, hard limit
        uint32_t                        m_numSkinningAttributes : 2;

        int32_t                         m_anchorY : 24;
        uint32_t                        m_numTriangles : 6;                     // Stored as ( count - 1 ), max 64 triangles per cluster, hard limit
        uint32_t                        m_numTextureCoordinateAttributes : 2;

        int32_t                         m_anchorZ : 24;
        int32_t                         m_sharedExponent : 8;

        uint32_t                        m_numColorAttributes : 2;
        uint32_t                        m_numPositionBitsX : 4;                 // Bits used to store ( position - anchor ) per axis, stored as ( numBits - 1 ), max 16 per axis
        uint32_t                        m_numPositionBitsY : 4;
        uint32_t                        m_numPositionBitsZ : 4;
        uint32_t                        m_hasMeshDecalData : 1;                 // Does this cluster contain per triangle mesh decal data
        uint32_t                        m_reserved : 17;

        uint16_t                        m_aabb[6];                              // Anchor-relative AABB min/max offsets

        uint32_t                        m_dataOffsetIn8ByteBlocks;              // Buffer-relative offset to cluster vertex data

        #ifndef __cplusplus
        int3 GetAnchor() { return int3( m_anchorX, m_anchorY, m_anchorZ ); }

        uint GetDataOffsetInBytes()
        {
            return m_dataOffsetIn8ByteBlocks * 8;
        }

        uint GetNumPositionBitsX()
        {
            return m_numPositionBitsX + 1;
        }

        uint GetNumPositionBitsY()
        {
            return m_numPositionBitsY + 1;
        }

        uint GetNumPositionBitsZ()
        {
            return m_numPositionBitsZ + 1;
        }

        uint GetPositionBitsPerVertex()
        {
            return GetNumPositionBitsX() + GetNumPositionBitsY() + GetNumPositionBitsZ();
        }

        uint GetPositionBitsSize()
        {
            uint const numBits = ( m_numVertices + 1 ) * GetPositionBitsPerVertex();
            return ( ( numBits + 31 ) & ~31U ) / 8;
        }

        uint GetNormalsOffset()
        {
            return GetPositionBitsSize();
        }

        uint GetUVsOffset()
        {
            return GetNormalsOffset() + ( ( ( m_numVertices + 1 ) * sizeof( VertexNormalAttribute ) + 3 ) & ~3U );
        }

        uint GetColorsOffset()
        {
            return GetUVsOffset() + m_numTextureCoordinateAttributes * ( m_numVertices + 1 ) * sizeof( TextureCoordinateAttribute );
        }

        uint GetSkinningOffset()
        {
            return GetColorsOffset() + m_numColorAttributes * ( m_numVertices + 1 ) * sizeof( VertexColorAttribute );
        }

        uint GetTrianglesOffset()
        {
            return GetSkinningOffset() + m_numSkinningAttributes * ( m_numVertices + 1 ) * sizeof( SkinningAttribute );
        }

        uint GetTriangleDataSize()
        {
            uint const numTriangles = m_numTriangles + 1;
            uint const dataSize = ( numTriangles * 3 * TRIANGLE_INDEX_BITS + 31 ) / 32 * 4;
            uint const dataSizeWithPadding = ( m_numTriangles * 3 * TRIANGLE_INDEX_BITS / 32 ) * 4 + 8;
            return max( dataSize, dataSizeWithPadding );
        }

        uint GetMeshDecalDataOffset()
        {
            return GetTrianglesOffset() + GetTriangleDataSize();
        }

        uint GetVertexNormalOffset( uint vertexIndex )
        {
            return GetNormalsOffset() + vertexIndex * sizeof( VertexNormalAttribute );
        }

        uint GetVertexUVOffset( uint attributeIndex, uint vertexIndex )
        {
            return GetUVsOffset() + attributeIndex * ( m_numVertices + 1 ) * sizeof( TextureCoordinateAttribute ) + vertexIndex * sizeof( TextureCoordinateAttribute );
        }

        uint GetVertexColorOffset( uint attributeIndex, uint vertexIndex )
        {
            return GetColorsOffset() + attributeIndex * ( m_numVertices + 1 ) * sizeof( VertexColorAttribute ) + vertexIndex * sizeof( VertexColorAttribute );
        }

        uint GetSkinningAttributeOffset( uint attributeIndex, uint vertexIndex )
        {
            return GetSkinningOffset() + attributeIndex * ( m_numVertices + 1 ) * sizeof( SkinningAttribute ) + vertexIndex * sizeof( SkinningAttribute );
        }

        void GetAABB( out float3 aabbMin, out float3 aabbMax )
        {
            int3 const anchor = GetAnchor();
            aabbMin = ldexp( float3( anchor ) + float3( m_aabb[0], m_aabb[1], m_aabb[2] ), m_sharedExponent );
            aabbMax = ldexp( float3( anchor ) + float3( m_aabb[3], m_aabb[4], m_aabb[5] ), m_sharedExponent );
        }
        #endif
    };

    HLSL_STATIC_ASSERT( sizeof( MeshCluster ) == 32, "Mesh cluster must be exactly 32 bytes" );

    struct HLSL_ALIGN_STRUCT MeshHeader
    {
        float3                          m_aabbCenterLocal;
        float3                          m_aabbHalfExtentsLocal;

        uint                            m_meshDecalOffset;                      // Byte offset of the MeshDecal array at the end of the buffer, 0 if there are no mesh decals
        uint                            m_numClusters;
    };

    HLSL_STATIC_ASSERT( sizeof( MeshHeader ) == 32, "Mesh header must be exactly 32 bytes" );

    //-------------------------------------------------------------------------

    struct HLSL_ALIGN_STRUCT MeshDecalData
    {
        uint                            m_projectionBasisOffset;
        uint                            m_projectionOffset;
        uint                            m_decalTableOffset;
        uint                            m_numProjections;
    };

    HLSL_STATIC_ASSERT( sizeof( MeshDecalData ) == 16, "Mesh decal data must be exactly 16 bytes" );

    struct HLSL_ALIGN_STRUCT MeshDecal
    {
        uint16_t                        m_albedoTexture;
        uint16_t                        m_pbrTexture;
        uint16_t                        m_normalTexture;
        uint16_t                        m_emissiveTexture;
        uint16_t                        m_parallaxTexture;
        float16_t                       m_tiling;

        uint                            m_flags                         : 16;
        uint                            m_shapeRadius                   : 8;
        uint                            m_heightOffset                  : 8;

        uint                            m_packedTintedColor;
        uint                            m_packedEmissiveColor;

        float2                          m_worldSize;                            // Full extent of the decal face, used for tiling

        #ifndef __cplusplus
        bool HasFlag( uint flag ) { return ( m_flags & flag ) == flag; }

        float GetShapeRadius() { return float( m_shapeRadius ) / 255.0; }
        float GetHeightOffset() { return ( float( m_heightOffset ) - 128.0 ) * ( 1.0 / 127.0 ); }
        #endif
    };

    HLSL_STATIC_ASSERT( sizeof( MeshDecal ) == 32, "Mesh decal must be exactly 32 bytes" );

    struct HLSL_ALIGN_STRUCT MeshDecalProjectionBasis
    {
        float16_t4                      m_linear;                               // 2x2 linear part applied to ( uv - m_anchorUV )
        float2                          m_anchorUV;
    };

    HLSL_STATIC_ASSERT( sizeof( MeshDecalProjectionBasis ) == 16, "Mesh decal projection basis must be exactly 16 bytes" );

    struct HLSL_ALIGN_STRUCT MeshDecalProjection
    {
        uint16_t                        m_basisIndex;
        uint16_t                        m_decalIndex;
        float16_t2                      m_offset;
    };

    HLSL_STATIC_ASSERT( sizeof( MeshDecalProjection ) == 8, "Mesh decal projection must be exactly 8 bytes" );

    static const uint                   g_meshDecalOffsetMask = 0x00FFFFFFU;
    static const uint                   g_meshDecalCountShift = 24U;
    static const uint                   g_meshDecalMaxCountPerTriangle = 255U;

EE_END_SHADER_TYPES_NAMESPACE

#ifndef __cplusplus

    // Adapted from "Triangle Visibility" Buffer and "AMD GeometryFX"
    // https://github.com/GPUOpen-Effects/GeometryFX/blob/master/amd_geometryfx/src/Shaders/AMD_GeometryFX_Filtering.hlsl
    // https://diaryofagraphicsprogrammer.blogspot.com/2018/03/triangle-visibility-buffer.html
    bool IsTriangleCulled( float4 clipVertices[3], float2 renderTargetSize, bool twoSided )
    {
        // Backface cull
        if ( !twoSided )
        {
            // "Triangle Scan Conversion using 2D Homogeneus Coordinates" by Marc Olano, Trey Greer
            precise float backfaceDeterminant = determinant( float3x3( clipVertices[0].xyw, clipVertices[1].xyw, clipVertices[2].xyw ) );
            if ( backfaceDeterminant <= 0 )
            {
                return true;
            }
        }

        // Clipping cull
        uint numVerticesOutsideOfClipPlane = 0;
        float2 screenVertices[3];
        [unroll] for ( uint vertexIndex = 0; vertexIndex < 3; ++vertexIndex )
        {
            precise float2 screenVertex = ( clipVertices[vertexIndex].xy / clipVertices[vertexIndex].w ) * 0.5 + 0.5.xx;
        
            screenVertices[vertexIndex] = screenVertex;
            [flatten] if ( clipVertices[vertexIndex].w < 0.0 )
            {
                numVerticesOutsideOfClipPlane++;
            }
        }

        if ( numVerticesOutsideOfClipPlane == 3 )
        {
            // Triangle is fully outside of the clip plane
            return true;
        }

        if ( numVerticesOutsideOfClipPlane != 0 )
        {
            // Triangle is clipped, we can't do anything else with it.
            return false;
        }

        // Frustum cull
        float screenMinY = min( min( screenVertices[0].y, screenVertices[1].y ), screenVertices[2].y );
        float screenMinX = min( min( screenVertices[0].x, screenVertices[1].x ), screenVertices[2].x );
        float screenMaxX = max( max( screenVertices[0].x, screenVertices[1].x ), screenVertices[2].x );
        float screenMaxY = max( max( screenVertices[0].y, screenVertices[1].y ), screenVertices[2].y );

        if ( ( screenMaxX < 0 ) || ( screenMaxY < 0 ) || ( screenMinX > 1 ) || ( screenMinY > 1 ) )
        {
            return true;
        }

        // Overlap cull, culls triangles that don't overlap pixel centers.
        // Uses 23.8 fixed-point math to match what the hardware is doing.
        const uint SUBPIXEL_BITS          = 8;
        const uint SUBPIXEL_MASK          = 0xFF;
        const uint SUBPIXEL_SAMPLES       = 1U << SUBPIXEL_BITS;
        const uint SUBPIXEL_SAMPLE_CENTER = SUBPIXEL_SAMPLES >> 1;
        const uint SUBPIXEL_SAMPLE_SIZE   = SUBPIXEL_SAMPLES - 1;

        int2 minBB = ( 1 << 30 ).xx;
        int2 maxBB = -minBB;

        [unroll] for ( uint vertexIndex = 0; vertexIndex < 3; ++vertexIndex )
        {
            float2 viewportPositionFP = screenVertices[vertexIndex].xy * renderTargetSize;
            int2 viewportPosition = int2( viewportPositionFP * SUBPIXEL_SAMPLES );
            minBB = min( minBB, viewportPosition );
            maxBB = max( maxBB, viewportPosition );
        }

        int2 testMin = minBB & SUBPIXEL_MASK;
        int2 testMax = maxBB - ( ( minBB & ~SUBPIXEL_MASK ) + SUBPIXEL_SAMPLE_CENTER );

        if ( any( and( testMin > SUBPIXEL_SAMPLE_CENTER, testMax < SUBPIXEL_SAMPLE_SIZE ) ) )
        {
            return true;
        }

        return false;
    }

    // Packed mesh buffer layout:
    //
    //     [ MeshHeader ][ MeshCluster 0 ][ MeshCluster 1 ] ... [ MeshCluster N-1 ]
    //     [ cluster 0 data ][ cluster 1 data ] ...
    //
    // Clusters are strictly sequential and directly addressable:
    //
    //     clusterAddress = sizeof( MeshHeader ) + clusterIndex * sizeof( MeshCluster )
    //
    // Each cluster stores m_dataOffsetIn8ByteBlocks pointing to its data.
    //
    //     [ position bits: numVertices * ( bitsX + bitsY + bitsZ ), padded to 4 B ]
    //     [ normals: numVertices * sizeof( VertexNormalAttribute ), padded to 4 B ]
    //     [ uv0/uv1: numVertices * sizeof( TextureCoordinateAttribute ) ]
    //     [ color0: numVertices * sizeof( VertexColorAttribute ) ]
    //     [ skinning: numSkinning * numVertices * sizeof( SkinningAttribute ) ]
    //     [ triangle bits: numTriangles * 3 * TRIANGLE_INDEX_BITS, padded for the last 64-bit load ]

    uint GetMeshClusterAddress( uint clusterIndex )
    {
        return sizeof( MeshHeader ) + clusterIndex * sizeof( MeshCluster );
    }

    uint LoadMeshBufferBits( ByteAddressBuffer meshBuffer, uint bitOffset, uint numBits )
    {
        uint const byteAddress = ( bitOffset / 32 ) * sizeof( uint );
        uint const shift = bitOffset & 31;

        uint bits = meshBuffer.Load( byteAddress ) >> shift;
        if ( shift + numBits > 32 )
        {
            bits |= meshBuffer.Load( byteAddress + sizeof( uint ) ) << ( 32 - shift );
        }

        return bits & ( ( 1U << numBits ) - 1U );
    }

    float3 LoadClusterVertexPosition( ByteAddressBuffer meshBuffer, MeshCluster cluster, uint vertexIndex )
    {
        uint const bitsX = cluster.GetNumPositionBitsX();
        uint const bitsY = cluster.GetNumPositionBitsY();
        uint const bitsZ = cluster.GetNumPositionBitsZ();
        uint const bitsPerVertex = bitsX + bitsY + bitsZ;

        uint const bitOffset = vertexIndex * bitsPerVertex + cluster.GetDataOffsetInBytes() * 8;
        uint const byteAddress = ( bitOffset / 32 ) * sizeof( uint );
        uint const shift = bitOffset & 31;

        uint64_t bits = meshBuffer.Load( byteAddress );
        if ( shift + bitsPerVertex > 32 )
        {
            bits |= uint64_t( meshBuffer.Load( byteAddress + sizeof( uint ) ) ) << 32;
        }
        bits >>= shift;
        if ( shift + bitsPerVertex > 64 )
        {
            bits |= uint64_t( meshBuffer.Load( byteAddress + 2 * sizeof( uint ) ) ) << ( 64 - shift );
        }

        uint3 compressedPosition;
        compressedPosition.x = uint( bits ) & ( ( 1U << bitsX ) - 1U );
        compressedPosition.y = uint( bits >> bitsX ) & ( ( 1U << bitsY ) - 1U );
        compressedPosition.z = uint( bits >> ( bitsX + bitsY ) ) & ( ( 1U << bitsZ ) - 1U );

        int3 decompressedPosition = cluster.GetAnchor() + int3( compressedPosition );
        return ldexp( decompressedPosition, cluster.m_sharedExponent );
    }

    float3 LoadClusterVertexNormal( ByteAddressBuffer meshBuffer, uint normalAddress )
    {
        VertexNormalAttribute const packedNormal = meshBuffer.Load<VertexNormalAttribute>( normalAddress );
        return max( float3( packedNormal ) * ( 1.0 / 32767.0 ), -1.0 );
    }

    uint3 LoadMeshClusterTriangle( ByteAddressBuffer meshBuffer, MeshCluster cluster, uint triangleIndex )
    {
        uint const bitOffset = triangleIndex * 3 * TRIANGLE_INDEX_BITS + ( cluster.GetDataOffsetInBytes() + cluster.GetTrianglesOffset() ) * 8;
        uint const indices = LoadMeshBufferBits( meshBuffer, bitOffset, 3 * TRIANGLE_INDEX_BITS );

        return uint3( indices & 0x3F, ( indices >> 6 ) & 0x3F, ( indices >> 12 ) & 0x3F );
    }
#endif

#endif
