#include "Base/Render/RHI.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct FFX_ParallelSort_CountResourceTable
{
    RWStructuredBuffer<uint>  m_srcBuffer;
    RWStructuredBuffer<uint>  m_sumTable;
    uint            m_shiftBit;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_Count.esh"

ESF_PARAMETER string ShaderType = "Compute";

#define FFX_CountRootSignature   EE_BEGIN_ROOT_SIGNATURE \
                                 FFX_ParallelSort_CountResourceTableRootConstant( "b0", "space=0" ) \
                                 "CBV( b1, space = 0 )"

EE_DECLARE_ROOT_CONSTANTS( FFX_ParallelSort_CountResourceTableData, b0, space0 );
EE_DECLARE_ROOT_CBV( FFX_ParallelSortCB, b1, space0 );

//-------------------------------------------------------------------------

[RootSignature( FFX_CountRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint localID : SV_GroupThreadID, uint groupID : SV_GroupID )
{
    FFX_ParallelSort_CountResourceTable resourceTable = CreateFFX_ParallelSort_CountResourceTable( RootConstants );

    FFX_ParallelSort_Count_uint( localID, groupID, RootCBV, RootConstants.m_shiftBit, resourceTable.m_srcBuffer, resourceTable.m_sumTable );
}
