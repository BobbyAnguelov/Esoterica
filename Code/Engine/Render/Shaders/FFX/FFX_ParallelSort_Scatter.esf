#ifndef __cplusplus
#define FFX_HLSL
#include "FFX_ParallelSort.esh"
#endif

#include "Base/Render/RHI.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct FFX_ParallelSort_ScatterResourceTable
{
    RWStructuredBuffer<uint>  m_srcBuffer;
    RWStructuredBuffer<uint>  m_dstBuffer;
    RWStructuredBuffer<uint>  m_sumTable;
    uint            m_shiftBit;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_Scatter.esh"

ESF_PARAMETER string ShaderType = "Compute";

#define FFX_ScatterRootSignature   EE_BEGIN_ROOT_SIGNATURE \
                                   FFX_ParallelSort_ScatterResourceTableRootConstant( "b0", "space=0" ) \
                                   "CBV( b1, space = 0 )"

EE_DECLARE_ROOT_CONSTANTS( FFX_ParallelSort_ScatterResourceTableData, b0, space0 );
EE_DECLARE_ROOT_CBV( FFX_ParallelSortCB, b1, space0 );

//-------------------------------------------------------------------------

[RootSignature( FFX_ScatterRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint localID : SV_GroupThreadID, uint groupID : SV_GroupID )
{
    FFX_ParallelSort_ScatterResourceTable resourceTable = CreateFFX_ParallelSort_ScatterResourceTable( RootConstants );

    FFX_ParallelSort_Scatter_uint( localID, groupID, RootCBV, RootConstants.m_shiftBit, resourceTable.m_srcBuffer, resourceTable.m_dstBuffer, resourceTable.m_sumTable );
}
