#ifndef __cplusplus
#define FFX_HLSL
#include "FFX_ParallelSort.esh"
#endif

#include "Base/Render/RHI.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct FFX_ParallelSort_ReduceResourceTable
{
    RWStructuredBuffer<uint>  m_sumTable;
    RWStructuredBuffer<uint>  m_reduceTable;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_Reduce.esh"

ESF_PARAMETER string ShaderType = "Compute";

#define FFX_ReduceRootSignature   EE_BEGIN_ROOT_SIGNATURE \
                                  FFX_ParallelSort_ReduceResourceTableRootConstant( "b0", "space=0" ) \
                                  "CBV( b1, space = 0 )"

EE_DECLARE_ROOT_CONSTANTS( FFX_ParallelSort_ReduceResourceTableData, b0, space0 );
EE_DECLARE_ROOT_CBV( FFX_ParallelSortCB, b1, space0 );

//-------------------------------------------------------------------------

[RootSignature( FFX_ReduceRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint localID : SV_GroupThreadID, uint groupID : SV_GroupID )
{
    FFX_ParallelSort_ReduceResourceTable resourceTable = CreateFFX_ParallelSort_ReduceResourceTable( RootConstants );

    FFX_ParallelSort_ReduceCount( localID, groupID, RootCBV, resourceTable.m_sumTable, resourceTable.m_reduceTable );
}
