#ifndef __cplusplus
#define FFX_HLSL
#include "FFX_ParallelSort.esh"
#endif

#include "Base/Render/RHI.esh"

#ifndef __cplusplus
#define EE_SHADER_REFLECTION_DATA_ONLY
#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_Count.esh"
#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_Reduce.esh"
#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_ScanAdd.esh"
#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_Scatter.esh"
#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_ScatterPayload.esh"
#undef EE_SHADER_REFLECTION_DATA_ONLY
#endif

EE_BEGIN_SHADER_TYPES_NAMESPACE

    struct HLSL_ALIGN_STRUCT FFX_ParallelSort_CountIndirectArgument
    {
        FFX_ParallelSort_CountResourceTableData     m_resourceTable;
        uint64_t                                    m_rootCBV;
        uint3                                       m_dispatchArguments;
        uint                                        m_padding;
    };

    struct HLSL_ALIGN_STRUCT FFX_ParallelSort_ReduceIndirectArgument
    {
        FFX_ParallelSort_ReduceResourceTableData    m_resourceTable;
        uint64_t                                    m_rootCBV;
        uint3                                       m_dispatchArguments;
        uint                                        m_padding;
    };

    struct HLSL_ALIGN_STRUCT FFX_ParallelSort_ScanAddIndirectArgument
    {
        FFX_ParallelSort_ScanAddResourceTableData   m_resourceTable;
        uint64_t                                    m_rootCBV;
        uint3                                       m_dispatchArguments;
        uint                                        m_padding;
    };

    struct HLSL_ALIGN_STRUCT FFX_ParallelSort_ScatterIndirectArgument
    {
        FFX_ParallelSort_ScatterResourceTableData   m_resourceTable;
        uint64_t                                    m_rootCBV;
        uint3                                       m_dispatchArguments;
        uint                                        m_padding0;
        uint                                        m_padding1;
        uint                                        m_padding2;
    };

    struct HLSL_ALIGN_STRUCT FFX_ParallelSort_ScatterPayloadIndirectArgument
    {
        FFX_ParallelSort_ScatterPayloadResourceTableData m_resourceTable;
        uint64_t                                    m_rootCBV;
        uint3                                       m_dispatchArguments;
        uint                                        m_padding0;
        uint                                        m_padding1;
        uint                                        m_padding2;
    };

    HLSL_STATIC_ASSERT( sizeof( FFX_ParallelSort_CountIndirectArgument ) == 32, "Indirect argument layout must match the CPU side" );
    HLSL_STATIC_ASSERT( sizeof( FFX_ParallelSort_ReduceIndirectArgument ) == 32, "Indirect argument layout must match the CPU side" );
    HLSL_STATIC_ASSERT( sizeof( FFX_ParallelSort_ScanAddIndirectArgument ) == 32, "Indirect argument layout must match the CPU side" );
    HLSL_STATIC_ASSERT( sizeof( FFX_ParallelSort_ScatterIndirectArgument ) == 48, "Indirect argument layout must match the CPU side" );
    HLSL_STATIC_ASSERT( sizeof( FFX_ParallelSort_ScatterPayloadIndirectArgument ) == 48, "Indirect argument layout must match the CPU side" );

EE_END_SHADER_TYPES_NAMESPACE

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct FFX_ParallelSort_SetupIndirectResourceTable
{
    RWStructuredBuffer<uint>                              m_numKeysBuffer;
    RWStructuredBuffer<uint>                              m_constantsBuffer;

    RWStructuredBuffer<FFX_ParallelSort_CountIndirectArgument>          m_countArguments;
    RWStructuredBuffer<FFX_ParallelSort_ReduceIndirectArgument>         m_reduceArguments;
    RWStructuredBuffer<FFX_ParallelSort_ScanAddIndirectArgument>        m_scanAddArguments;
    RWStructuredBuffer<FFX_ParallelSort_ScatterIndirectArgument>        m_scatterArguments;
    RWStructuredBuffer<FFX_ParallelSort_ScatterPayloadIndirectArgument> m_scatterPayloadArgs;

    uint16_t                                    m_keysAHandle;
    uint16_t                                    m_keysBHandle;
    uint16_t                                    m_payloadAHandle;
    uint16_t                                    m_payloadBHandle;
    uint16_t                                    m_scratchHandle;
    uint16_t                                    m_reducedHandle;

    uint64_t                                    m_rootCBVAddress;
    uint                                        m_maxThreadGroups;
};
#endif

#ifndef __cplusplus
#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_SetupIndirect.esh"
#endif

#ifndef __cplusplus

ESF_PARAMETER string ShaderType = "Compute";

#define FFX_SetupIndirectRootSignature   EE_BEGIN_ROOT_SIGNATURE \
                                         FFX_ParallelSort_SetupIndirectResourceTableRootConstant( "b0", "space=0" )

EE_DECLARE_ROOT_CONSTANTS( FFX_ParallelSort_SetupIndirectResourceTableData, b0, space0 );

//-------------------------------------------------------------------------

[RootSignature( FFX_SetupIndirectRootSignature )]
[numthreads( 1, 1, 1 )]
void CS_main( uint3 dispatchThreadID : SV_DispatchThreadID )
{
    FFX_ParallelSort_SetupIndirectResourceTable resourceTable = CreateFFX_ParallelSort_SetupIndirectResourceTable( RootConstants );

    // Same data distribution as FFX_ParallelSort_SetConstantAndDispatchData, written to the FFX_ParallelSortCB layout
    const uint NumKeys = resourceTable.m_numKeysBuffer[0];

    const uint BlockSize = FFX_PARALLELSORT_ELEMENTS_PER_THREAD * FFX_PARALLELSORT_THREADGROUP_SIZE;
    const uint NumBlocks = ( NumKeys + BlockSize - 1 ) / BlockSize;

    uint NumThreadGroupsToRun = resourceTable.m_maxThreadGroups;
    uint BlocksPerThreadGroup = NumBlocks / NumThreadGroupsToRun;
    uint NumThreadGroupsWithAdditionalBlocks = NumBlocks % NumThreadGroupsToRun;

    if ( NumBlocks < NumThreadGroupsToRun )
    {
        BlocksPerThreadGroup = 1;
        NumThreadGroupsToRun = NumBlocks;
        NumThreadGroupsWithAdditionalBlocks = 0;
    }

    const uint NumReducedThreadGroupsToRun = FFX_PARALLELSORT_SORT_BIN_COUNT * ( ( BlockSize > NumThreadGroupsToRun ) ? 1 : ( NumThreadGroupsToRun + BlockSize - 1 ) / BlockSize );

    // FFX_ParallelSortCB layout: NumKeys, NumBlocksPerThreadGroup, NumThreadGroups, NumThreadGroupsWithAdditionalBlocks, NumReduceThreadgroupPerBin, NumScanValues
    resourceTable.m_constantsBuffer[0] = NumKeys;
    resourceTable.m_constantsBuffer[1] = BlocksPerThreadGroup;
    resourceTable.m_constantsBuffer[2] = NumThreadGroupsToRun;
    resourceTable.m_constantsBuffer[3] = NumThreadGroupsWithAdditionalBlocks;
    resourceTable.m_constantsBuffer[4] = NumReducedThreadGroupsToRun / FFX_PARALLELSORT_SORT_BIN_COUNT;
    resourceTable.m_constantsBuffer[5] = NumReducedThreadGroupsToRun;

    const uint64_t rootCBV = resourceTable.m_rootCBVAddress;

    // One argument per pass - the keys ping-pong between the A and B buffers
    const bool hasPayload = resourceTable.m_payloadAHandle != 0;

    [unroll( 8 )]
    for ( uint passIndex = 0; passIndex < 8; ++passIndex )
    {
        const uint shift = passIndex * 4;
        const uint srcHandle = ( passIndex & 1 ) ? resourceTable.m_keysBHandle : resourceTable.m_keysAHandle;
        const uint dstHandle = ( passIndex & 1 ) ? resourceTable.m_keysAHandle : resourceTable.m_keysBHandle;

        FFX_ParallelSort_CountResourceTableData countData = (FFX_ParallelSort_CountResourceTableData)0;
        countData.m_shiftBit = shift;
        countData.SetSrcBuffer( uint16_t( srcHandle ) );
        countData.SetSumTable( uint16_t( resourceTable.m_scratchHandle ) );

        FFX_ParallelSort_CountIndirectArgument countArgument = (FFX_ParallelSort_CountIndirectArgument)0;
        countArgument.m_resourceTable                = countData;
        countArgument.m_rootCBV                      = rootCBV;
        countArgument.m_dispatchArguments            = uint3( NumThreadGroupsToRun, 1, 1 );
        resourceTable.m_countArguments[passIndex]    = countArgument;

        FFX_ParallelSort_ScatterResourceTableData scatterData = (FFX_ParallelSort_ScatterResourceTableData)0;
        scatterData.m_shiftBit = shift;
        scatterData.SetSrcBuffer( uint16_t( srcHandle ) );
        scatterData.SetDstBuffer( uint16_t( dstHandle ) );
        scatterData.SetSumTable( uint16_t( resourceTable.m_scratchHandle ) );

        FFX_ParallelSort_ScatterIndirectArgument scatterArgument = (FFX_ParallelSort_ScatterIndirectArgument)0;
        scatterArgument.m_resourceTable             = scatterData;
        scatterArgument.m_rootCBV                   = rootCBV;
        scatterArgument.m_dispatchArguments         = uint3( NumThreadGroupsToRun, 1, 1 );
        resourceTable.m_scatterArguments[passIndex] = scatterArgument;

        if ( hasPayload )
        {
            const uint paySrcHandle = ( passIndex & 1 ) ? resourceTable.m_payloadBHandle : resourceTable.m_payloadAHandle;
            const uint payDstHandle = ( passIndex & 1 ) ? resourceTable.m_payloadAHandle : resourceTable.m_payloadBHandle;

            FFX_ParallelSort_ScatterPayloadResourceTableData scatterPayloadData = (FFX_ParallelSort_ScatterPayloadResourceTableData)0;
            scatterPayloadData.m_shiftBit = shift;
            scatterPayloadData.SetSrcBuffer( uint16_t( srcHandle ) );
            scatterPayloadData.SetDstBuffer( uint16_t( dstHandle ) );
            scatterPayloadData.SetSumTable( uint16_t( resourceTable.m_scratchHandle ) );
            scatterPayloadData.SetSrcPayload( uint16_t( paySrcHandle ) );
            scatterPayloadData.SetDstPayload( uint16_t( payDstHandle ) );

            FFX_ParallelSort_ScatterPayloadIndirectArgument scatterPayloadArg = (FFX_ParallelSort_ScatterPayloadIndirectArgument)0;
            scatterPayloadArg.m_resourceTable               = scatterPayloadData;
            scatterPayloadArg.m_rootCBV                     = rootCBV;
            scatterPayloadArg.m_dispatchArguments           = uint3( NumThreadGroupsToRun, 1, 1 );
            resourceTable.m_scatterPayloadArgs[passIndex]   = scatterPayloadArg;
        }
    }

    // Single reusable argument for the reduce and scan-add passes
    FFX_ParallelSort_ReduceResourceTableData reduceData = (FFX_ParallelSort_ReduceResourceTableData)0;
    reduceData.SetSumTable( uint16_t( resourceTable.m_scratchHandle ) );
    reduceData.SetReduceTable( uint16_t( resourceTable.m_reducedHandle ) );

    FFX_ParallelSort_ReduceIndirectArgument reduceArgument = (FFX_ParallelSort_ReduceIndirectArgument)0;
    reduceArgument.m_resourceTable       = reduceData;
    reduceArgument.m_rootCBV             = rootCBV;
    reduceArgument.m_dispatchArguments   = uint3( NumReducedThreadGroupsToRun, 1, 1 );
    resourceTable.m_reduceArguments[0]   = reduceArgument;

    FFX_ParallelSort_ScanAddResourceTableData scanAddData = (FFX_ParallelSort_ScanAddResourceTableData)0;
    scanAddData.SetScanSrc( uint16_t( resourceTable.m_scratchHandle ) );
    scanAddData.SetScanDst( uint16_t( resourceTable.m_scratchHandle ) );
    scanAddData.SetScanScratch( uint16_t( resourceTable.m_reducedHandle ) );

    FFX_ParallelSort_ScanAddIndirectArgument scanAddArgument = (FFX_ParallelSort_ScanAddIndirectArgument)0;
    scanAddArgument.m_resourceTable      = scanAddData;
    scanAddArgument.m_rootCBV            = rootCBV;
    scanAddArgument.m_dispatchArguments  = uint3( NumReducedThreadGroupsToRun, 1, 1 );
    resourceTable.m_scanAddArguments[0]  = scanAddArgument;
}

#endif
