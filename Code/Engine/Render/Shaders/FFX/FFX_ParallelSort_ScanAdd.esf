#ifndef __cplusplus
#define FFX_HLSL
#include "FFX_ParallelSort.esh"
#endif

#include "Base/Render/RHI.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct FFX_ParallelSort_ScanAddResourceTable
{
    RWStructuredBuffer<uint>  m_scanSrc;
    RWStructuredBuffer<uint>  m_scanDst;
    RWStructuredBuffer<uint>  m_scanScratch;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_ScanAdd.esh"

ESF_PARAMETER string ShaderType = "Compute";

#define FFX_ScanAddRootSignature   EE_BEGIN_ROOT_SIGNATURE \
                                   FFX_ParallelSort_ScanAddResourceTableRootConstant( "b0", "space=0" ) \
                                   "CBV( b1, space = 0 )"

EE_DECLARE_ROOT_CONSTANTS( FFX_ParallelSort_ScanAddResourceTableData, b0, space0 );
EE_DECLARE_ROOT_CBV( FFX_ParallelSortCB, b1, space0 );

//-------------------------------------------------------------------------

[RootSignature( FFX_ScanAddRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint localID : SV_GroupThreadID, uint groupID : SV_GroupID )
{
    FFX_ParallelSort_ScanAddResourceTable resourceTable = CreateFFX_ParallelSort_ScanAddResourceTable( RootConstants );

    // Same bin/chunk indexing as ReduceCount - each group processes a different slice
    uint BlockSize = FFX_PARALLELSORT_ELEMENTS_PER_THREAD * FFX_PARALLELSORT_THREADGROUP_SIZE;
    uint BinID     = groupID / RootCBV.NumReduceThreadgroupPerBin;
    uint BinOffset = BinID * RootCBV.NumThreadGroups;
    uint BaseIndex = ( groupID % RootCBV.NumReduceThreadgroupPerBin ) * BlockSize;

    FFX_ParallelSort_ScanPrefix( RootCBV.NumThreadGroups, localID, groupID, BinOffset, BaseIndex, true, RootCBV, resourceTable.m_scanSrc, resourceTable.m_scanDst, resourceTable.m_scanScratch );
}
