#include "Base/Render/RHI.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct FFX_ParallelSort_ScatterPayloadResourceTable
{
    RWStructuredBuffer<uint>  m_srcBuffer;
    RWStructuredBuffer<uint>  m_dstBuffer;
    RWStructuredBuffer<uint>  m_sumTable;
    RWStructuredBuffer<uint>  m_srcPayload;
    RWStructuredBuffer<uint>  m_dstPayload;
    uint            m_shiftBit;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_ScatterPayload.esh"

ESF_PARAMETER string ShaderType = "Compute";

#define FFX_ScatterPayloadRootSignature   EE_BEGIN_ROOT_SIGNATURE \
                                          FFX_ParallelSort_ScatterPayloadResourceTableRootConstant( "b0", "space=0" ) \
                                          "CBV( b1, space = 0 )"

EE_DECLARE_ROOT_CONSTANTS( FFX_ParallelSort_ScatterPayloadResourceTableData, b0, space0 );
EE_DECLARE_ROOT_CBV( FFX_ParallelSortCB, b1, space0 );

//-------------------------------------------------------------------------

[RootSignature( FFX_ScatterPayloadRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint localID : SV_GroupThreadID, uint groupID : SV_GroupID )
{
    FFX_ParallelSort_ScatterPayloadResourceTable resourceTable = CreateFFX_ParallelSort_ScatterPayloadResourceTable( RootConstants );

    FFX_ParallelSort_Scatter_uint( localID, groupID, RootCBV, RootConstants.m_shiftBit, resourceTable.m_srcBuffer, resourceTable.m_dstBuffer, resourceTable.m_sumTable, resourceTable.m_srcPayload, resourceTable.m_dstPayload );
}
