
#include "Engine/Render/Shaders/Renderer/DefaultMeshShader.esh"
#include "Engine/Render/Shaders/Renderer/MaterialShaderPBR.esh"
#include "Engine/Render/Shaders/Materials/Parallax.esh"

ESF_PARAMETER string ShaderType = "Material";

ESF_CUSTOM_PARAMETERS struct CustomParameters : ShaderParameters
{
    Color                           m_albedoColor               ESF_DEFAULT_VALUE( 0xFFFFFFFF );
    Color                           m_emissiveColor             ESF_DEFAULT_VALUE( 0xFFFFFFFF );

    float                           m_emissiveStrength          ESF_DEFAULT_VALUE( 1.0F ) ESF_MIN_VALUE( 0.0F );
    float                           m_metalness                 ESF_DEFAULT_VALUE( 1.0F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 1.0F );
    float                           m_roughness                 ESF_DEFAULT_VALUE( 1.0F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 1.0F );
    float                           m_occlusion                 ESF_DEFAULT_VALUE( 1.0F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 1.0F );

    float                           m_maxDisplacement           ESF_DEFAULT_VALUE( 0.5F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 2.0F );

    Texture2D                       m_albedoTexture             ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultWhite.texture" );
    Texture2D                       m_normalTexture             ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultNormal.texture" );
    Texture2D                       m_pbrTexture                ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultPBR.texture" );
    Texture2D                       m_emissiveTexture           ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultBlack.texture" );
    Texture2D                       m_parallaxTexture           ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultParallax.texture" );
};

#include "Engine/_Module/_AutoGenerated/ShaderReflection/PrincipledPBR.esh"

MaterialShaderOutput MaterialShaderMain( in MaterialShaderInput materialInput )
{
    ByteAddressBuffer       shaderDataBuffer        = GetBuffer( RootCBV.m_shaderDataBuffer );

    CustomParameters        customParameters        = LoadCustomParameters( shaderDataBuffer, materialInput.m_primitive.GetShaderParametersOffsetIn32ByteBlocks() );
    MaterialShaderOutput    materialOutput          = MaterialShaderOutput::New( materialInput );

    SamplerState            linearSampler           = GetLinearWrapSampler();

    //-------------------------------------------------------------------------

    float2                  materialUV              = materialInput.m_vertex.m_uv.xy;

    // Parallax
    //-------------------------------------------------------------------------

    float materialHeight = 0.0;

    #ifndef PERMUTATION_DEPTH_ONLY

    #ifdef ENABLE_PARALLAX
    [branch] if ( customParameters.m_maxDisplacement > 0.0 )
    {
        // TBN is recomputed here to avoid allocating 12 VGPR
        float3 const viewTangent = mul( materialInput.m_view, materialInput.ComputeTBN() );
        float2 const uvDensity = float2
        (
            length( float2( materialInput.m_ddxUV.x, materialInput.m_ddyUV.x ) ),
            length( float2( materialInput.m_ddxUV.y, materialInput.m_ddyUV.y ) )
        );

        float const worldPerPixel = max( 0.5F * ( length( materialInput.m_ddxWorldPosition ) + length( materialInput.m_ddyWorldPosition ) ), 1e-5F );

        float3 const parallax = ParallaxMarch
        (
            customParameters.m_parallaxTexture,
            linearSampler,
            materialUV,
            materialInput.m_ddxUV,
            materialInput.m_ddyUV,
            viewTangent,
            ( customParameters.m_maxDisplacement / worldPerPixel ) * uvDensity,
            RootCBV.m_parallaxMaxSteps,
            RootCBV.m_parallaxErrorPixels,
            RootCBV.m_parallaxReliefFadeCosLow,
            RootCBV.m_parallaxReliefFadeCosHigh,
            materialOutput.m_numParallaxSteps
        );

        materialUV      = parallax.xy;
        materialHeight  = parallax.z;
    }
    #endif

    #endif

    //-------------------------------------------------------------------------

    float4 const            albedoSample            = customParameters.m_albedoTexture.SampleGrad( linearSampler, materialUV, materialInput.m_ddxUV, materialInput.m_ddyUV );
    float4 const            pbrSample               = customParameters.m_pbrTexture.SampleGrad( linearSampler, materialUV, materialInput.m_ddxUV, materialInput.m_ddyUV );
    float4 const            albedoColor             = UnpackColor( customParameters.m_albedoColor );
    float2 const            normalSample            = customParameters.m_normalTexture.SampleGrad( linearSampler, materialUV, materialInput.m_ddxUV, materialInput.m_ddyUV ).rg;

    materialOutput.m_albedo     = albedoSample.rgb * albedoColor.rgb;
    materialOutput.m_opacity    = albedoSample.a * albedoColor.a * customParameters.m_opacity;
    materialOutput.m_normal     = materialInput.UnpackNormalMap( materialInput.ComputeTBN(), normalSample );
    materialOutput.m_metalness  = saturate( pbrSample.r * customParameters.m_metalness );
    materialOutput.m_occlusion  = saturate( pbrSample.g * customParameters.m_occlusion );
    materialOutput.m_roughness  = saturate( pbrSample.a * customParameters.m_roughness );

    //-------------------------------------------------------------------------

    materialOutput.m_height                 = ( customParameters.m_maxDisplacement > 0.0 ) ? materialHeight : 0.0;
    materialOutput.m_maxDisplacement        = customParameters.m_maxDisplacement;

    //-------------------------------------------------------------------------

    [branch] if ( customParameters.m_emissiveStrength > 0.001 )
    {
        float3 const        emissiveColor       = UnpackColor( customParameters.m_emissiveColor ).rgb;
        float3 const        emissiveSample      = customParameters.m_emissiveTexture.SampleGrad( linearSampler, materialUV, materialInput.m_ddxUV, materialInput.m_ddyUV ).rgb;

        materialOutput.m_emissiveColor          = emissiveSample * emissiveColor * customParameters.m_emissiveStrength;
    }

    return materialOutput;
}
