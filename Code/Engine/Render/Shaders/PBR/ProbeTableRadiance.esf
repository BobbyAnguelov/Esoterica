
#include "Engine/Render/Shaders/Renderer/RendererTypes.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct ProbeTableRadianceResourceTable
{
    TextureCube                         m_inputTexture;
    StructuredBuffer<float4>            m_probeTable;
    StructuredBuffer<RenderView>        m_renderViewBuffer;
    RWTexture2DArray<float4>            m_outputTexture;
    uint                                m_renderViewIndex;
    uint                                m_level;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/ProbeTableRadiance.esh"

#ifndef __cplusplus

#include "Engine/Render/Shaders/CommonSamplers.esh"
#include "Engine/Render/Shaders/PBR/ProbeTableShape.esh"

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_ROOT_CONSTANTS( ProbeTableRadianceResourceTableData, b0, space0 );

#define ProbeTableRadianceRootSignature EE_BEGIN_ROOT_SIGNATURE \
                                        ProbeTableRadianceResourceTableRootConstant( "b0", "space=0" )

// Parameter order within a tap, as the table stores it
#define PARAM_DIR0   0
#define PARAM_DIR1   1
#define PARAM_DIR2   2
#define PARAM_LEVEL  3
#define PARAM_WEIGHT 4

static const uint TAPS_PER_AXIS  = PROBE_TABLE_TAPS_PER_AXIS;
static const uint NUM_AXES       = 3;
static const uint NUM_ACTIVE     = PROBE_TABLE_NUM_ACTIVE_COEFFICIENTS;
static const uint NUM_PARAMETERS = 5;
static const uint NUM_SUPER_TAPS = TAPS_PER_AXIS / 4;
static const uint NUM_INDICES    = ( NUM_AXES * TAPS_PER_AXIS ) / 4;

static const float3 kAxisX = float3( 1.0, 0.0, 0.0 );
static const float3 kAxisY = float3( 0.0, 1.0, 0.0 );
static const float3 kAxisZ = float3( 0.0, 0.0, 1.0 );

//-------------------------------------------------------------------------

float MajorComponent( float3 v )
{
    return max( abs( v.x ), max( abs( v.y ), abs( v.z ) ) );
}

void PolynomialArguments( float otherX, float otherY, float own, out float theta, out float phi )
{
    float const maxXY   = max( abs( otherX ), abs( otherY ) );
    float const scaledX = otherX / maxXY;
    float const scaledY = otherY / maxXY;

    theta = ( scaledY < scaledX ) ? scaledY : -scaledY;

    float const ownAbsolute = abs( own );

    phi = ( ownAbsolute >= 0.999 ) ? maxXY : ownAbsolute;
}

//-------------------------------------------------------------------------

float TapParameter( StructuredBuffer<float4> probeTable, uint level, uint parameter, uint index, uint subTap, float theta2, float phi2 )
{
    float value = 0.0;

    [unroll]
    for ( uint coefficient = 0; coefficient < NUM_ACTIVE; ++coefficient )
    {
        uint const slot = ( ( ( level * NUM_PARAMETERS ) + parameter ) * NUM_ACTIVE + coefficient ) * NUM_INDICES + index;

        float const basis = ( coefficient == 0 ) ? 1.0 : ( ( coefficient == 1 ) ? theta2 : phi2 );

        value += basis * probeTable[slot][subTap];
    }

    return value;
}

//-------------------------------------------------------------------------

void AccumulateFrame
(
    StructuredBuffer<float4> probeTable,
    TextureCube source,
    SamplerState sourceSampler,
    uint level,
    uint axisIndex,
    float3 axis,
    float otherX,
    float otherY,
    float own,
    float3 frameZ,
    inout float3 accumulated,
    inout float weightSum
)
{
    float const frameWeight = ( max( abs( otherX ), abs( otherY ) ) - 0.75 ) * 4.0;

    if ( frameWeight <= 0.0 )
    {
        return;
    }

    float3 frameX = cross( axis, frameZ );
    float const frameXLength = length( frameX );

    if ( frameXLength <= 0.0 )
    {
        return;
    }

    frameX /= frameXLength;
    float3 const frameY = cross( frameZ, frameX );

    float theta = 0.0;
    float phi   = 0.0;
    PolynomialArguments( otherX, otherY, own, theta, phi );

    float const theta2 = theta * theta;
    float const phi2   = phi * phi;

    [unroll]
    for ( uint superTap = 0; superTap < NUM_SUPER_TAPS; ++superTap )
    {
        uint const index = ( NUM_SUPER_TAPS * axisIndex ) + superTap;

        [unroll]
        for ( uint subTap = 0; subTap < 4; ++subTap )
        {
            float3 tapDirection;
            tapDirection.x = TapParameter( probeTable, level, PARAM_DIR0, index, subTap, theta2, phi2 );
            tapDirection.y = TapParameter( probeTable, level, PARAM_DIR1, index, subTap, theta2, phi2 );
            tapDirection.z = TapParameter( probeTable, level, PARAM_DIR2, index, subTap, theta2, phi2 );

            float const major = MajorComponent( tapDirection );

            if ( major <= 0.0 )
            {
                continue;
            }

            tapDirection /= major;

            float const levelCorrection = 0.75 * log2( dot( tapDirection, tapDirection ) );

            float const tapLevel  = TapParameter( probeTable, level, PARAM_LEVEL, index, subTap, theta2, phi2 ) + levelCorrection;
            float const tapWeight = TapParameter( probeTable, level, PARAM_WEIGHT, index, subTap, theta2, phi2 ) * frameWeight;

            float3 const worldDirection = ( tapDirection.x * frameX ) + ( tapDirection.y * frameY ) + ( tapDirection.z * frameZ );

            float const sourceLevel = max( tapLevel, 0.0 );

            accumulated += tapWeight * source.SampleLevel( sourceSampler, worldDirection, sourceLevel ).rgb;
            weightSum   += tapWeight;
        }
    }
}

//-------------------------------------------------------------------------

float3 FilterProbeCube( StructuredBuffer<float4> probeTable, TextureCube source, SamplerState sourceSampler, float3 n, uint level )
{
    float3 const frameZ = normalize( n );

    float3 const faceVector = n / MajorComponent( n );

    float3 accumulated = 0.0;
    float  weightSum   = 0.0;

    AccumulateFrame( probeTable, source, sourceSampler, level, 0, kAxisX, faceVector.y, faceVector.z, faceVector.x, frameZ, accumulated, weightSum );
    AccumulateFrame( probeTable, source, sourceSampler, level, 1, kAxisY, faceVector.x, faceVector.z, faceVector.y, frameZ, accumulated, weightSum );
    AccumulateFrame( probeTable, source, sourceSampler, level, 2, kAxisZ, faceVector.x, faceVector.y, faceVector.z, frameZ, accumulated, weightSum );

    return ( weightSum > 0.0 ) ? ( accumulated / weightSum ) : 0.0;
}

//-------------------------------------------------------------------------

[numthreads( 8, 8, 1 )]
void CS_main( uint3 dispatchThreadID : SV_DispatchThreadID )
{
    ProbeTableRadianceResourceTable resourceTable       = CreateProbeTableRadianceResourceTable( RootConstants );

    RenderView const                renderView          = resourceTable.m_renderViewBuffer[resourceTable.m_renderViewIndex + dispatchThreadID.z];
    SamplerState                    linearWrapSampler   = GetLinearWrapSampler();

    //-------------------------------------------------------------------------

    uint outputWidth  = 0;
    uint outputHeight = 0;
    uint numSlices    = 0;
    resourceTable.m_outputTexture.GetDimensions( outputWidth, outputHeight, numSlices );

    if ( ( dispatchThreadID.x >= outputWidth ) || ( dispatchThreadID.y >= outputHeight ) || ( dispatchThreadID.z >= numSlices ) )
    {
        return;
    }

    float2 const uv         = ( float2( dispatchThreadID.xy ) + 0.5 ) / float2( outputWidth, outputHeight );
    float2 const ndc        = float2( ( uv.x * 2.0 ) - 1.0, 1.0 - ( uv.y * 2.0 ) );
    float3 const direction  = normalize( mul( renderView.m_inverseViewProjectionMatrix, float4( ndc, 0.0, 1.0 ) ).xyz );

    float3 const filtered   = FilterProbeCube( resourceTable.m_probeTable, resourceTable.m_inputTexture, linearWrapSampler, direction, resourceTable.m_level );

    resourceTable.m_outputTexture[dispatchThreadID] = float4( filtered, 1.0 );
}

#endif
