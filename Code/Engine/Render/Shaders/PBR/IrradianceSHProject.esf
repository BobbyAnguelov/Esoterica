
#include "Engine/Render/Shaders/Renderer/RendererTypes.esh"

#ifndef __cplusplus

#include "Engine/Render/Shaders/SH/SH.esh"

ESF_RESOURCE_TABLE struct IrradianceSHProjectResourceTable
{
    TextureCube                     m_inputTexture;
    StructuredBuffer<RenderView>    m_renderViewBuffer;

    RWStructuredBuffer<SH::L2_RGB>  m_shCoefficients;

    uint                            m_renderViewIndex;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/IrradianceSHProject.esh"

#ifndef __cplusplus

#include "Engine/Render/Shaders/CommonSamplers.esh"

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_ROOT_CONSTANTS( IrradianceSHProjectResourceTableData, b0, space0 );

#define IrradianceSHProjectRootSignature    EE_BEGIN_ROOT_SIGNATURE \
                                            IrradianceSHProjectResourceTableRootConstant( "b0", "space=0" )

groupshared float3 gsProjectedSH[256];

//-------------------------------------------------------------------------

float3 CubeTexelDirection( StructuredBuffer<RenderView> renderViewBuffer, uint renderViewIndex, uint2 texelCoord, uint resolution )
{
    float2 const uv  = ( float2( texelCoord ) + 0.5 ) / float2( resolution, resolution );
    float2 const ndc = float2( ( uv.x * 2.0 ) - 1.0, 1.0 - ( uv.y * 2.0 ) );

    RenderView const renderView = renderViewBuffer[renderViewIndex];

    return normalize( mul( renderView.m_inverseViewProjectionMatrix, float4( ndc, 0.0, 1.0 ) ).xyz );
}

//-------------------------------------------------------------------------

[numthreads( 256, 1, 1 )]
void CS_main( uint groupIndex : SV_GroupIndex )
{
    IrradianceSHProjectResourceTable        resourceTable       = CreateIrradianceSHProjectResourceTable( RootConstants );

    TextureCube                             inputTexture        = resourceTable.m_inputTexture;
    RWStructuredBuffer<SH::L2_RGB>          shCoefficients      = resourceTable.m_shCoefficients;
    StructuredBuffer<RenderView>            renderViewBuffer    = resourceTable.m_renderViewBuffer;

    SamplerState                            linearWrapSampler   = GetLinearWrapSampler();

    //-------------------------------------------------------------------------

    uint captureWidth = 0;
    uint captureHeight = 0;
    inputTexture.GetDimensions( captureWidth, captureHeight );

    uint const numTexelsPerFace = captureWidth * captureHeight;
    SH::L2_RGB accumulated = SH::L2_RGB::Zero();

    for ( uint texel = groupIndex; texel < 6 * numTexelsPerFace; texel += 256 )
    {
        uint const face = texel / numTexelsPerFace;
        uint const faceTexel = texel % numTexelsPerFace;
        uint2 const texelCoord = uint2( faceTexel % captureWidth, faceTexel / captureWidth );

        float3 const direction = CubeTexelDirection( renderViewBuffer, resourceTable.m_renderViewIndex + face, texelCoord, captureWidth );

        float const major = max( abs( direction.x ), max( abs( direction.y ), abs( direction.z ) ) );
        float const solidAngle = ( 4.0 * major * major * major ) / ( float( captureWidth ) * float( captureWidth ) );

        float3 const radiance = inputTexture.SampleLevel( linearWrapSampler, direction, 0 ).rgb;

        accumulated = accumulated + SH::ProjectOntoL2( direction, radiance ) * solidAngle;
    }

    //-------------------------------------------------------------------------

    for ( uint coefficient = 0; coefficient < uint( SH::L2_RGB::NumCoefficients ); ++coefficient )
    {
        gsProjectedSH[groupIndex] = accumulated.C[coefficient];

        GroupMemoryBarrierWithGroupSync();

        for ( uint stride = 256 / 2; stride > 0; stride >>= 1 )
        {
            if ( groupIndex < stride )
            {
                gsProjectedSH[groupIndex] += gsProjectedSH[groupIndex + stride];
            }

            GroupMemoryBarrierWithGroupSync();
        }

        accumulated.C[coefficient] = gsProjectedSH[0];
    }

    if ( groupIndex == 0 )
    {
        shCoefficients[0] = accumulated;
    }
}

#endif
